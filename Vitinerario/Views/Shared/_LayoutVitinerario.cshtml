    <div id="mobile-menu-overlay" class="hidden fixed inset-0 z-[2000] bg-dark-charcoal/98 backdrop-blur-2xl flex-col justify-center items-center">

        @* La X ora è fixed con padding per essere sempre centrata nell'angolo *@
        <button id="close-menu-btn" class="fixed top-8 right-8 text-white p-4 hover:text-primary transition-colors">
            <span class="material-icons text-4xl">close</span>
        </button>

        <nav class="flex flex-col items-center gap-10 font-display text-2xl tracking-[0.2em] uppercase text-white">
            <a class="hover:text-primary transition-colors mobile-link" href="@Url.Action("Archive")">Articoli</a>
            <a class="hover:text-primary transition-colors mobile-link" href="@Url.Action("Events")">Events</a>
           @*  <a class="hover:text-primary transition-colors mobile-link" href="@Url.Action("Producers")">Producers</a> *@
            <a class="hover:text-primary transition-colors mobile-link" href="@Url.Action("Podcast")">Podcast</a>
        </nav>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const nav = document.getElementById('floating-nav');
            const btnDown = document.getElementById('btn-down');
            const footer = document.querySelector('footer');

            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const closeMenuBtn = document.getElementById('close-menu-btn');
            const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');

            if(mobileMenuBtn && closeMenuBtn && mobileMenuOverlay) {
                mobileMenuBtn.addEventListener('click', () => {
                    mobileMenuOverlay.classList.remove('hidden');
                    mobileMenuOverlay.classList.add('flex');
                    document.body.style.overflow = 'hidden';
                });

                closeMenuBtn.addEventListener('click', () => {
                    mobileMenuOverlay.classList.add('hidden');
                    mobileMenuOverlay.classList.remove('flex');
                    document.body.style.overflow = '';
                });

                // Close when clicking a link
                document.querySelectorAll('.mobile-link').forEach(link => {
                    link.addEventListener('click', () => {
                        mobileMenuOverlay.classList.add('hidden');
                        mobileMenuOverlay.classList.remove('flex');
                        document.body.style.overflow = '';
                    });
                });
            }

            document.addEventListener('scroll', function() {
                const scrollY = window.scrollY;

                // Show after 300px
                if (scrollY > 300) {
                    nav.classList.add('visible');
                } else {
                    nav.classList.remove('visible');
                }

                // Hide down button at footer
                if (footer) {
                    const footerRect = footer.getBoundingClientRect();
                    if (footerRect.top < window.innerHeight) {
                        btnDown.style.display = 'none';
                    } else {
                        btnDown.style.display = 'flex';
                    }
                }
            });
        });
    </script>
