<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vitinerario</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,700;0,900;1,400&family=Noto+Sans:wght@400;500;700&family=Montserrat:wght@700;800;900&family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
    <!-- Tailwind Library (Loaded last to respect config) -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- Material Icons/Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />

    <!-- Custom Fonts -->
    <link href="https://fonts.cdnfonts.com/css/lovelo" rel="stylesheet">

    <!-- Page Specific Config -->
    @await RenderSectionAsync("TailwindConfig", required: false)

   
    @await RenderSectionAsync("Styles", required: false)

    <style>
        /* Floating Nav & Scroll Btn (Native CSS to be safe) */
        #floating-nav {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            z-index: 1040;
            transition: opacity 0.3s ease;
            opacity: 0;
            pointer-events: none;
        }
        #floating-nav.visible {
            opacity: 1;
            pointer-events: auto;
        }
        .scroll-btn {
            background-color: #d31a53;
            color: white;
            border: none;
            border-radius: 50%;
            width: 3rem;
            height: 3rem;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
            transition: transform 0.2s;
        }
        .scroll-btn:hover {
            transform: scale(1.1);
        }
        @@media (max-width: 768px) {
             #floating-nav {
                bottom: 5rem;
                right: 1rem;
             }
        }
    </style>
</head>
<body class="bg-[#121212] text-white antialiased">
    <header class="fixed top-0 w-full z-50 border-b border-white/10 bg-background-dark/80 backdrop-blur-md px-6 lg:px-20 py-4">
        <div class="max-w-[1440px] mx-auto flex items-center justify-between">
            <div class="flex items-center gap-3">
               @*  <div class="text-primary">
                    <svg class="size-6" fill="currentColor" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                        <path d="M24 0.757355L47.2426 24L24 47.2426L0.757355 24L24 0.757355ZM21 35.7574V12.2426L9.24264 24L21 35.7574Z"></path>
                    </svg>
                </div> *@
                @* <h1 class="lov-heading text-xl font-black tracking-tighter text-white">Vitinerario</h1> *@
                <a href="@Url.Action("Index", "Home")">
                    <img src="/Assets/img/Logo Vitinerario bianco.svg" alt="Vitinerario" class="h-8 w-auto">
                </a>
            </div>
            <nav class="hidden md:flex items-center gap-12 font-refined text-xs tracking-widest uppercase text-slate-100">
                <a class="hover:text-primary transition-colors" href="@Url.Action("Archive")">Archive</a>
                <a class="hover:text-primary transition-colors" href="@Url.Action("Events")">Events</a>
                <a class="hover:text-primary transition-colors" href="@Url.Action("Producers")">Producers</a>
                <a class="hover:text-primary transition-colors" href="@Url.Action("Podcast")">Podcast</a>
            </nav>
           @*  <div class="flex items-center gap-6">
                <button class="bg-primary hover:bg-primary/90 text-white px-6 py-2.5 rounded-sm font-refined text-xs font-bold uppercase tracking-widest transition-all">
                    Inquire Now
                </button>
            </div> *@
        </div>
    </header>
    @RenderBody()

    <!-- Floating Navigation -->
    <div id="floating-nav">
        <button id="btn-up" class="scroll-btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
            <span class="material-icons">arrow_upward</span>
        </button>
        <button id="btn-down" class="scroll-btn" onclick="window.scrollTo({top: document.body.scrollHeight, behavior: 'smooth'})">
            <span class="material-icons">arrow_downward</span>
        </button>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

    <footer class="bg-dark-charcoal border-t border-white/5 py-24">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-16 mb-24">
            <div class="col-span-1">
                @* <a class="nav-brand text-2xl font-black tracking-tighter text-primary block mb-8" href="/">VITINERARIO</a> *@
                    <a class="nav-brand block mb-8" href="/">
                        <img src="~/Assets/img/Logo Vitinerario bianco.svg" alt="Vitinerario" class="h-10 w-auto">
                    </a>
                <p class="text-xs text-white/40 leading-relaxed uppercase tracking-widest">
                    The definitive guide for the modern connoisseur of fine wine, culture, and slow travel.
                </p>
            </div>
            <div>
                <h6 class="text-[10px] uppercase tracking-widest-plus font-black mb-8 text-primary">Discover</h6>
                <ul class="space-y-4 text-[11px] uppercase tracking-widest text-white/50 font-bold">
                    <li><a href="#" class="hover:text-primary transition-colors">Wine Region Guides</a></li>
                    <li><a href="#" class="hover:text-primary transition-colors">Culture & Arts</a></li>
                    <li><a href="#" class="hover:text-primary transition-colors">Luxury Lodging</a></li>
                    <li><a href="#" class="hover:text-primary transition-colors">Interviews</a></li>
                </ul>
            </div>
            <div>
                <h6 class="text-[10px] uppercase tracking-widest-plus font-black mb-8 text-primary">Magazine</h6>
                <ul class="space-y-4 text-[11px] uppercase tracking-widest text-white/50 font-bold">
                    <li><a href="#" class="hover:text-primary transition-colors">The Latest Issue</a></li>
                    <li><a href="@Url.Action("Archive")" class="hover:text-primary transition-colors">Archive</a></li>
                    <li><a href="#" class="hover:text-primary transition-colors">Contributors</a></li>
                    <li><a href="#" class="hover:text-primary transition-colors">Subscriptions</a></li>
                </ul>
            </div>
            <div>
                <h6 class="text-[10px] uppercase tracking-widest-plus font-black mb-8 text-primary">Follow</h6>
                <div class="flex space-x-8">
                    <a href="#" class="text-white/40 hover:text-primary transition-colors"><span class="material-icons text-xl">camera_alt</span></a>
                    <a href="#" class="text-white/40 hover:text-primary transition-colors"><span class="material-icons text-xl">facebook</span></a>
                    <a href="#" class="text-white/40 hover:text-primary transition-colors"><span class="material-icons text-xl">alternate_email</span></a>
                </div>
            </div>
        </div>
        <div class="flex flex-col md:flex-row items-center justify-between pt-12 border-t border-white/5 text-[9px] uppercase tracking-widest-plus font-black text-white/20">
                <p>© 2026 Graldev S.a.S. di Chiera Luigi. Tutti i diritti riservati.</p>
            <div class="flex space-x-10 mt-6 md:mt-0">
                <a href="#" class="hover:text-primary">Privacy Policy</a>
                <a href="@Url.Action("Terms")" class="hover:text-primary">Terms of Service</a>
                <a href="#" class="hover:text-primary">Cookies</a>
            </div>
        </div>
    </div>
</footer>


    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const nav = document.getElementById('floating-nav');
            const btnDown = document.getElementById('btn-down');
            const footer = document.querySelector('footer');

            document.addEventListener('scroll', function() {
                const scrollY = window.scrollY;

                // Show after 300px
                if (scrollY > 300) {
                    nav.classList.add('visible');
                } else {
                    nav.classList.remove('visible');
                }

                // Hide down button at footer
                if (footer) {
                    const footerRect = footer.getBoundingClientRect();
                    if (footerRect.top < window.innerHeight) {
                        btnDown.style.display = 'none';
                    } else {
                        btnDown.style.display = 'flex';
                    }
                }
            });
        });
    </script>
</body>
</html>
