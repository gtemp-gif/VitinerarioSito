    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const nav = document.getElementById('floating-nav');
            const btnDown = document.getElementById('btn-down');
            const footer = document.querySelector('footer');
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const closeMenuBtn = document.getElementById('close-menu-btn');
            const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');

            if(mobileMenuBtn && closeMenuBtn && mobileMenuOverlay) {
                mobileMenuBtn.addEventListener('click', () => {
                    mobileMenuOverlay.classList.remove('hidden');
                    mobileMenuOverlay.classList.add('flex');
                    document.body.style.overflow = 'hidden';
                });

                closeMenuBtn.addEventListener('click', () => {
                    mobileMenuOverlay.classList.add('hidden');
                    mobileMenuOverlay.classList.remove('flex');
                    document.body.style.overflow = '';
                });

                document.querySelectorAll('.mobile-link').forEach(link => {
                    link.addEventListener('click', () => {
                        mobileMenuOverlay.classList.add('hidden');
                        mobileMenuOverlay.classList.remove('flex');
                        document.body.style.overflow = '';
                    });
                });
            }

            document.addEventListener('scroll', function() {
                const scrollY = window.scrollY;
                if (scrollY > 300) { nav.classList.add('visible'); }
                else { nav.classList.remove('visible'); }

                const docHeight = document.documentElement.scrollHeight - window.innerHeight;
                const scrollPercent = docHeight > 0 ? (scrollY / docHeight) : 0;
                const offsetUp = 289 - (scrollPercent * 289);
                const offsetDown = scrollPercent * 289;

                if(document.getElementById('progress-up')) document.getElementById('progress-up').style.strokeDashoffset = offsetUp;
                if(document.getElementById('progress-down')) document.getElementById('progress-down').style.strokeDashoffset = offsetDown;

                if (footer) {
                    const footerRect = footer.getBoundingClientRect();
                    if (footerRect.top < window.innerHeight) { btnDown.style.display = 'none'; }
                    else { btnDown.style.display = 'flex'; }
                }
            });

            handleCookiesBanner();
        });

        function handleCookiesBanner() {
            const cookiesBanner = document.querySelector(".cookies-banner-container");
            if (!cookiesBanner) return;
            if (!getCookie("accepted_cookies")) {
                cookiesBanner.style.display = "block";
                const acceptBtn = cookiesBanner.querySelector(".cookies-banner__accept-btn button");
                if (acceptBtn) {
                    acceptBtn.addEventListener("click", function () {
                        setCookie("accepted_cookies", "true", 365);
                        cookiesBanner.style.transition = "transform 0.5s ease, opacity 0.5s ease";
                        cookiesBanner.style.transform = "translateY(100%)";
                        cookiesBanner.style.opacity = "0";
                        setTimeout(() => cookiesBanner.remove(), 500);
                    });
                }
            } else { cookiesBanner.remove(); }
        }

        function setCookie(name, value, days) {
            let expires = "";
            if (days) {
                const date = new Date();
                date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);
                expires = "; expires=" + date.toUTCString();
            }
            document.cookie = name + "=" + (value || "") + expires + "; path=/";
        }

        function getCookie(name) {
            const nameEQ = name + "=";
            const ca = document.cookie.split(';');
            for(let i=0; i < ca.length; i++) {
                let c = ca[i];
                while (c.charAt(0) === ' ') c = c.substring(1, c.length);
                if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length, c.length);
            }
            return null;
        }
    </script>
