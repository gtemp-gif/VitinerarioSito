<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vitinerario</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,700;0,900;1,400&family=Noto+Sans:wght@400;500;700&family=Montserrat:wght@700;800;900&family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">

    <!-- Material Icons/Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />

    <!-- Custom Fonts -->
    <link href="https://fonts.cdnfonts.com/css/lovelo" rel="stylesheet">

    <!-- Page Specific Config or Default Layout Config -->
    @if (IsSectionDefined("TailwindConfig"))
    {
        @await RenderSectionAsync("TailwindConfig", required: false)
    }
    else
    {
        <script>
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            "primary": "#d31a53",
                            "dark-charcoal": "#121212",
                            "charcoal-light": "#1e1e1e",
                            "accent-burgundy": "#d31a53"
                        },
                        fontFamily: {
                            "body": ["Roboto", "sans-serif"],
                            "display": ["Montserrat", "sans-serif"],
                            "lovelo": ["Montserrat", "sans-serif"]
                        },
                        letterSpacing: {
                            "widest-plus": "0.3em",
                            "architectural": "0.05em"
                        }
                    },
                },
            }
        </script>
    }

    <!-- Tailwind Library (Loaded last to respect config) -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    @await RenderSectionAsync("Styles", required: false)

    <style>
        /* Floating Nav & Scroll Btn (Native CSS to be safe) */
        #floating-nav {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            z-index: 1040;
            transition: opacity 0.3s ease;
            opacity: 0;
            pointer-events: none;
        }
        #floating-nav.visible {
            opacity: 1;
            pointer-events: auto;
        }
        .scroll-btn {
            background-color: #d31a53;
            color: white;
            border: none;
            border-radius: 50%;
            width: 3rem;
            height: 3rem;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
            transition: transform 0.2s;
        }
        .scroll-btn:hover {
            transform: scale(1.1);
        }
        @@media (max-width: 768px) {
             #floating-nav {
                bottom: 5rem;
                right: 1rem;
             }
        }
    </style>
</head>
<body class="bg-[#121212] text-white antialiased">
    @RenderBody()

    <!-- Floating Navigation -->
    <div id="floating-nav">
        <button id="btn-up" class="scroll-btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
            <span class="material-icons">arrow_upward</span>
        </button>
        <button id="btn-down" class="scroll-btn" onclick="window.scrollTo({top: document.body.scrollHeight, behavior: 'smooth'})">
            <span class="material-icons">arrow_downward</span>
        </button>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const nav = document.getElementById('floating-nav');
            const btnDown = document.getElementById('btn-down');
            const footer = document.querySelector('footer');

            document.addEventListener('scroll', function() {
                const scrollY = window.scrollY;

                // Show after 300px
                if (scrollY > 300) {
                    nav.classList.add('visible');
                } else {
                    nav.classList.remove('visible');
                }

                // Hide down button at footer
                if (footer) {
                    const footerRect = footer.getBoundingClientRect();
                    if (footerRect.top < window.innerHeight) {
                        btnDown.style.display = 'none';
                    } else {
                        btnDown.style.display = 'flex';
                    }
                }
            });
        });
    </script>
</body>
</html>
