<!DOCTYPE html>
<html lang="en" class="dark">
@using Microsoft.AspNetCore.Mvc.Localization
@using Vitinerario.Resources.Views.Shared
@inject IViewLocalizer Localizer
@{
        string? urlPolicy = Url.ActionLink("CookiePolicy", "Home");

        // --- LOGICA PER LO STATO ATTIVO DELLA NAVBAR ---
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        bool isHomePage = (currentController == "Home" && currentAction == "Index");
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vitinerario</title>
    <link rel="icon" type="image/png" href="~/Assets/img/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,700;0,900;1,400&family=Noto+Sans:wght@400;500;700&family=Montserrat:wght@400;500;600;700;800;900&family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />

    <link href="https://fonts.cdnfonts.com/css/lovelo" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet">

    @await RenderSectionAsync("TailwindConfig", required: false)

    @await RenderSectionAsync("Styles", required: false)

    <style>
        /* FORZATURA FONT GLOBALE */
        .font-display {
            font-family: 'Lovelo', sans-serif !important;
        }

        .font-refined {
            font-family: 'Montserrat', sans-serif !important;
        }

        /* Evita lo scroll orizzontale */
        body {
            overflow-x: hidden;
            width: 100%;
            position: relative;
        }

        #floating-nav {
            position: fixed;
            bottom: 2rem;
            right: 2.5rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            z-index: 1040;
            transition: opacity 0.3s ease;
            opacity: 0;
            pointer-events: none;
        }

            #floating-nav.visible {
                opacity: 1;
                pointer-events: auto;
            }

        @@media (max-width: 768px) {
            #floating-nav {
                bottom: 2rem;
                right: 1.5rem;
            }
        }
    </style>
</head>
<body class="bg-[#121212] text-white antialiased">
    @{
        int currentLangId = Vitinerario.Helpers.LanguageHelper.GetCurrentLangId(Context);
    }

    <header class="fixed top-0 w-full z-50 border-b border-white/10 bg-background-dark/80 backdrop-blur-md px-6 md:px-12 lg:px-20 py-4">
        <div class="max-w-[1440px] mx-auto flex items-center justify-between">
            <div class="flex items-center gap-3">
                <a href="@Url.Action("Index", "Home")">
                    <img src="/Assets/img/Logo Vitinerario bianco.svg" alt="Vitinerario" class="h-8 w-auto">
                </a>
            </div>

            <nav class="hidden md:flex items-center gap-12 font-refined text-xs tracking-widest uppercase text-slate-100">
                @if (!isHomePage)
                {
                    <a class="transition-colors hover:text-primary" href="@Url.Action("Index", "Home")">Home</a>
                }
                <a class="transition-colors @(currentAction == "Archive" || currentAction == "Article" ? "text-primary font-bold" : "hover:text-primary")" href="@Url.Action("Archive", "Home")">@Localizer[SharedResource.Articles]</a>
                <a class="transition-colors @(currentAction == "Events" || currentAction == "Event" ? "text-primary font-bold" : "hover:text-primary")" href="@Url.Action("Events", "Home")">@Localizer[SharedResource.Events]</a>
                <a class="transition-colors @(currentAction == "Podcast" ? "text-primary font-bold" : "hover:text-primary")" href="@Url.Action("Podcast", "Home")">@Localizer[SharedResource.Podcast]</a>
                <a class="transition-colors hover:text-primary" href="@Url.Action("Index", "Home")#app-section">App</a>
            </nav>

            <div class="flex items-center gap-6">
                <div class="flex items-center gap-3 font-refined text-[11px] font-black uppercase tracking-widest">
                    <a href="@Url.Action("ChangeLanguage", "Language", new { langId = 2, returnUrl = Context.Request.Path + Context.Request.QueryString })"
                       class="transition-colors @(currentLangId == 2 ? "text-primary" : "text-white/40 hover:text-white")">
                        IT
                    </a>
                    <span class="text-white/20 font-light">|</span>
                    <a href="@Url.Action("ChangeLanguage", "Language", new { langId = 1, returnUrl = Context.Request.Path + Context.Request.QueryString })"
                       class="transition-colors @(currentLangId == 1 ? "text-primary" : "text-white/40 hover:text-white")">
                        EN
                    </a>
                </div>

                <button id="mobile-menu-btn" class="md:hidden text-white flex items-center justify-center p-2 hover:text-primary transition-colors">
                    <span class="material-icons">menu</span>
                </button>
            </div>
        </div>
    </header>

    @RenderBody()

    <div id="floating-nav">
        <button id="btn-up" class="relative w-12 h-12 md:w-14 md:h-14 flex items-center justify-center rounded-full text-primary bg-black/30 backdrop-blur-sm shadow-lg transition-all duration-300 hover:bg-primary/20 hover:-translate-y-1 group" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
            <svg class="absolute inset-0 w-full h-full pointer-events-none transform -rotate-90" viewBox="0 0 100 100">
                <circle cx="50" cy="50" r="46" fill="none" stroke="currentColor" stroke-width="4" stroke-opacity="0.2" />
                <circle id="progress-up" cx="50" cy="50" r="46" fill="none" stroke="currentColor" stroke-width="4" stroke-dasharray="289" stroke-dashoffset="289" stroke-linecap="round" class="transition-[stroke-dashoffset] duration-75" />
            </svg>
            <span class="material-icons relative z-10 group-hover:scale-110 transition-transform">arrow_upward</span>
        </button>
        <button id="btn-down" class="relative w-12 h-12 md:w-14 md:h-14 flex items-center justify-center rounded-full text-primary bg-black/30 backdrop-blur-sm shadow-lg transition-all duration-300 hover:bg-primary/20 hover:-translate-y-1 group" onclick="window.scrollTo({top: document.body.scrollHeight, behavior: 'smooth'})">
            <svg class="absolute inset-0 w-full h-full pointer-events-none transform -rotate-90" viewBox="0 0 100 100">
                <circle cx="50" cy="50" r="46" fill="none" stroke="currentColor" stroke-width="4" stroke-opacity="0.2" />
                <circle id="progress-down" cx="50" cy="50" r="46" fill="none" stroke="currentColor" stroke-width="4" stroke-dasharray="289" stroke-dashoffset="0" stroke-linecap="round" class="transition-[stroke-dashoffset] duration-75" />
            </svg>
            <span class="material-icons relative z-10 group-hover:scale-110 transition-transform">arrow_downward</span>
        </button>
    </div>

    <div class="cookies-banner-container" role="region" aria-label="Cookies banner">
        <div id="cookieBannerDesktop" class="cookies-banner" role="alert">
            <div class="cookies-banner__icon" role="img" aria-label="Cookie icon" style="padding: 10px; align-items:center;margin-left: 10px;">
                <img src="https://img.icons8.com/offices/100/000000/cookies.png" alt="" aria-hidden="true" style="width:45px;" />
            </div>
            <div class="cookies-banner__info-text" style="padding: 10px;margin-right: 10px;">
                <div style="padding: 10px;" font face="Arial, Helvetica, sans-serif">
                    @Localizer[SharedResource.CookieBannerInfo] <a id="view-policy" href="/Home/CookiePolicy"> @Localizer[SharedResource.ClickHere]</a>
                    <br />@Localizer[SharedResource.CookieBannerWarning]
                </div>
            </div>
            <div class="cookies-banner__accept-btn" style="padding: 10px;"><button role="button" aria-label="Accept cookies">@Localizer[SharedResource.Accept]</button></div>
        </div>
    </div>

    <footer class="bg-dark-charcoal border-t border-white/5 pt-20 pb-10">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-20">

                <div class="md:col-span-6 flex flex-col items-center md:items-start text-center md:text-left">
                    <a class="nav-brand block mb-6" href="@Url.Action("Index", "Home")">
                        <img src="~/Assets/img/Logo Vitinerario bianco.svg" alt="Vitinerario" class="h-10 w-auto opacity-90 hover:opacity-100 transition-opacity">
                    </a>
                    <p class="text-white/60 font-refined text-sm leading-relaxed max-w-sm uppercase tracking-widest font-semibold">
                        Lasciati ispirare dai tuoi sensi.
                    </p>
                </div>

                <div class="md:col-span-3 flex flex-col items-center md:items-start">
                    <h4 class="text-white font-refined font-black uppercase tracking-[0.2em] text-sm mb-6">Esplora</h4>
                    <nav class="flex flex-col gap-4 font-refined text-xs tracking-widest uppercase text-white/40 font-semibold">
                        <a href="@Url.Action("Archive", "Home")" class="hover:text-primary transition-colors">@Localizer[SharedResource.Articles]</a>
                        <a href="@Url.Action("Events", "Home")" class="hover:text-primary transition-colors">@Localizer[SharedResource.Events]</a>
                        <a href="@Url.Action("Podcast", "Home")" class="hover:text-primary transition-colors">@Localizer[SharedResource.Podcast]</a>
                        <a href="@Url.Action("Index", "Home")#app-section" class="hover:text-primary transition-colors">Vitinerario App</a>
                    </nav>
                </div>

                <div class="md:col-span-3 flex flex-col items-center md:items-start">
