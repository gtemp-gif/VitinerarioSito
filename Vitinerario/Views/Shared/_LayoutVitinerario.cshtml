    <!-- Custom Fonts -->
    <link href="https://fonts.cdnfonts.com/css/lovelo" rel="stylesheet">

    <!-- Page Specific Config -->
    @await RenderSectionAsync("TailwindConfig", required: false)

   
    @await RenderSectionAsync("Styles", required: false)

    <style>
        /* 1. Evita lo scroll orizzontale che sposta i pulsanti fuori schermo */
        body {
            overflow-x: hidden;
            width: 100%;
            position: relative;
        }

        /* 2. Riposizionamento Floating Nav per sicurezza mobile */
        #floating-nav {
            position: fixed;
            bottom: 2rem;
            right: 2.5rem; /* Aumentato per staccarlo dal bordo ed evitare tagli */
            display: flex;
            flex-direction: column;
            gap: 1rem;
            z-index: 1040;
            transition: opacity 0.3s ease;
            opacity: 0;
            pointer-events: none;
        }

            #floating-nav.visible {
                opacity: 1;
                pointer-events: auto;
            }

        .scroll-btn {
            background-color: #d31a53;
            color: white;
            border: none;
            border-radius: 50%;
            width: 3.5rem;
            height: 3.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.4);
            transition: transform 0.2s;
        }

        @@media (max-width: 768px) {
            #floating-nav {
                bottom: 2rem;
                right: 1.5rem; /* Margine corretto per smartphone */
            }

            .scroll-btn {
                width: 3rem;
                height: 3rem;
            }
        }
    </style>



