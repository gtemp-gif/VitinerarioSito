        </div>
    </footer>

    <div id="mobile-menu-overlay" class="hidden fixed inset-0 z-[2000] bg-dark-charcoal/98 backdrop-blur-2xl flex-col justify-between pt-24 pb-12 px-6">
        <button id="close-menu-btn" class="fixed top-8 right-8 text-white p-4 hover:text-primary transition-colors z-50">
            <span class="material-icons text-4xl">close</span>
