@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization

@inject IViewLocalizer Localizer

@{
    var currentCulture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.Name ?? "it";
    var nextCulture = currentCulture == "it" ? "en" : "it";
    var nextCultureLabel = currentCulture == "it" ? "EN" : "IT";
}

<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vitinerario</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Vitinerario.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,700&display=swap" rel="stylesheet">
</head>
<body class="bg-black text-white">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-black fixed-top border-bottom border-secondary">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-route-culture="@currentCulture" asp-controller="Home" asp-action="Index">VITINERARIO</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-route-culture="@currentCulture" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">@Localizer["Articles"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">@Localizer["App"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">@Localizer["Partner"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-bold" asp-route-culture="@nextCulture" asp-controller="Home" asp-action="Index">@nextCultureLabel</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid p-0">
        <main role="main" class="pb-3" style="margin-top: 80px;">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top border-secondary footer text-white-50 bg-black mt-5">
        <div class="container text-center py-4">
            <p>&copy; 2025 Vitinerario - All rights reserved.</p>
            <p>
                <a class="text-white-50" asp-route-culture="@currentCulture" asp-controller="Home" asp-action="Privacy">Privacy & Cookies policy</a>
            </p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
