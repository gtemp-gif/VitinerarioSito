@{
    Layout = "_LayoutVitinerario";
    ViewData["Title"] = "Events";
}

 @section TailwindConfig {
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#d11a51",
                        "background-light": "#f8f6f6",
                        "background-dark": "#0a0506",
                        "charcoal": "#121212",
                    },
                    fontFamily: {
                        "display": ["Noto Serif", "serif"],
                        "sans": ["Noto Sans", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
}

@section Styles {
    <style>
        .lovelo-style {
            font-family: 'Noto Sans', sans-serif;
            letter-spacing: 0.1em;
            font-weight: 800;
        }
    </style>
} 

