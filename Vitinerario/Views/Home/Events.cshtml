@using Vitinerario.Models.Dtos
@model List<EventDto>
@{
    Layout = "_LayoutVitinerario";
    ViewData["Title"] = "Events";

    var eventsByYear = Model
        .GroupBy(e => e.EventDate.Year)
        .OrderBy(g => g.Key)
        .ToList();
}

@section TailwindConfig {
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#d31a53",
                        "dark-charcoal": "#121212",
                        "charcoal-light": "#1e1e1e",
                        "accent-burgundy": "#d31a53"
                    },
                    fontFamily: {
                        "body": ["Roboto", "sans-serif"],
                        "display": ["Montserrat", "sans-serif"],
                        "lovelo": ["Montserrat", "sans-serif"]
                    },
                    letterSpacing: {
                        "widest-plus": "0.3em",
                        "architectural": "0.05em"
                    }
                },
            },
        }
    </script>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const filterBtns = document.querySelectorAll('.filter-btn');
            const eventCards = document.querySelectorAll('.event-card');

            filterBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    // Update active button state
                    filterBtns.forEach(b => {
                        b.classList.remove('bg-primary', 'text-white', 'border-primary');
                        b.classList.add('text-white/50', 'border-white/10');
                    });
                    btn.classList.remove('text-white/50', 'border-white/10');
                    btn.classList.add('bg-primary', 'text-white', 'border-primary');

                    const selectedYear = btn.getAttribute('data-filter');

                    // Filter cards
                    eventCards.forEach(card => {
                        card.classList.remove('opacity-100', 'hidden');
                        card.classList.add('opacity-0');

                        setTimeout(() => {
                            if (selectedYear === 'all' || card.getAttribute('data-year') === selectedYear) {
                                card.classList.remove('hidden');
                                setTimeout(() => card.classList.replace('opacity-0', 'opacity-100'), 50);
                            } else {
                                card.classList.add('hidden');
                            }
                        }, 500); // Wait for fade out
                    });
                });
            });
        });
    </script>
}

<div class="relative flex min-h-screen w-full flex-col overflow-x-hidden bg-dark-charcoal text-white/90 font-body selection:bg-primary selection:text-white">

    <main class="flex-1 w-full">
        <!-- Hero Section -->
        <section class="relative h-[92vh] w-full overflow-hidden mb-24">
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuC706C-bHRrX6lWXKlv9iAruIHDJRRMOJByHazE0n5Ow9bYW0Bvg3XL7zP6KxRH_mScbxW_exKvnVK7fN7OyEmIX7J-H_2AOvhH-qcKKSBC7lwag0pS2RwsYmQYlO7faHw0jBvJWBKJagQmh4zBDRu9bZgLk2uWEpLOc3Ju4YrSdJJEtv8FOnrpX12QHrtnIvIrf-k_gP_LvW9qoFpvk1V2sGdCJz67nBBczHVBxtC65hmr-S2gbWoxlPfsyTyfohnhH3wKCYjuhzk" alt="Exclusive Events" class="absolute inset-0 w-full h-full object-cover" data-alt="Luxury wine cellar with candlelit table">
            <div class="absolute inset-0 bg-gradient-to-b from-dark-charcoal/20 to-dark-charcoal/80 flex items-end pb-32">
                <div class="max-w-7xl mx-auto px-6 w-full text-white">
                    <div class="max-w-4xl">
                        <span class="text-primary text-[10px] uppercase tracking-widest-plus font-black mb-4 block">Our Calendar</span>
                        <h1 class="text-6xl md:text-8xl font-black leading-[0.95] mb-8 text-balance font-display tracking-architectural uppercase">Exclusive <br>Experiences.</h1>
                        <p class="text-xl md:text-2xl font-light mb-10 text-white/80 max-w-2xl">Curated cultural journeys and private tastings across the world's finest estates.</p>
                    </div>
                </div>
            </div>
        </section>
       
        <div class="max-w-7xl mx-auto px-6 md:px-16 w-full mb-24">
            <!-- Filter Bar -->
            <div class="flex flex-col md:flex-row items-center justify-between gap-6 mb-12 border-b border-white/5 pb-8">
                <h3 class="font-display text-2xl md:text-3xl font-bold whitespace-nowrap text-white/90 uppercase tracking-architectural">Upcoming Events</h3>
                <div class="flex gap-4" id="year-filters">
                    <button class="filter-btn active bg-primary text-white border border-primary px-8 py-3 text-[10px] font-bold uppercase tracking-widest transition-all" data-filter="all">All</button>
                    @foreach (var yearGroup in eventsByYear)
                    {
                        <button class="filter-btn text-white/50 border border-white/10 hover:border-white/30 hover:text-white px-8 py-3 text-[10px] font-bold uppercase tracking-widest transition-all" data-filter="@yearGroup.Key">@yearGroup.Key</button>
                    }
                </div>
            </div>
        
            @if (eventsByYear.Count > 0)
            {
                @foreach (var yearGroup in eventsByYear)
                {
                    <section class="mb-24 event-card transition-opacity duration-500 opacity-100" data-year="@yearGroup.Key">
                        <div class="flex items-center gap-6 mb-12">
                            <h3 class="font-display text-2xl font-bold whitespace-nowrap text-white/90">Events @yearGroup.Key</h3>
                            <div class="h-[1px] w-full bg-gradient-to-r from-white/20 to-transparent"></div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
                            @foreach (var eventItem in yearGroup)
                            {
                                <div class="flex flex-col group cursor-pointer">
                                    <div class="relative aspect-[16/10] overflow-hidden rounded-lg mb-6">
                                        <img src="@eventItem.CoverImage" alt="@eventItem.Title" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" data-alt="@eventItem.Title">
                                        <div class="absolute top-4 left-4 bg-background-dark/90 backdrop-blur px-3 py-2 rounded border border-white/10 text-center min-w-[60px]">
                                            <p class="text-primary text-xl font-bold leading-none uppercase">@eventItem.EventDate.ToString("dd")</p>
                                            <p class="text-primary text-[10px] font-bold tracking-tighter uppercase">@eventItem.EventDate.ToString("MMM")</p>
                                        </div>
                                    </div>
                                    <h4 class="lovelo-style text-xl mb-2 group-hover:text-primary transition-colors uppercase">@eventItem.Title</h4>
                                    <div class="flex items-center gap-1.5 text-white/50 text-sm mb-4">
                                        <span class="material-symbols-outlined text-[18px]">location_on</span>
                                        <p class="font-display italic">@(string.IsNullOrEmpty(eventItem.Location) ? "To be announced" : eventItem.Location)</p>
                                    </div>
                                    <a href="@Url.Action("EventDetails", "Home", new { id = eventItem.Id })" class="flex items-center gap-2 text-primary font-bold text-xs tracking-[0.15em] hover:gap-4 transition-all uppercase">
                                        Details
                                        <span class="material-symbols-outlined text-[18px]">trending_flat</span>
                                    </a>
                                </div>
                            }
                        </div>
                    </section>
                }
            }
            else
            {
                <h3 class="font-display text-2xl font-bold whitespace-nowrap text-white/90 mt-10">No upcoming events found.</h3>
            }
        </div>
    </main>
</div>
