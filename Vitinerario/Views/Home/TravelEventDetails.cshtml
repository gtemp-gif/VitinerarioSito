@model Vitinerario.Models.TravelEventViewModel

@using Microsoft.AspNetCore.Mvc.Localization
@using Vitinerario.Resources.Views.Shared
@using Vitinerario.Helpers
@inject IViewLocalizer Localizer
@{
    Layout = "_LayoutVitinerario";
    //ViewData["Title"] = $"{Model.Event.Title} | Vitinerario Travel Details";
    ViewData["Title"] = $"{Model.Event.Title.Replace("<br>", " ").Replace("<BR>", " ").Replace("<br/>", " ").Replace("<br />", " ")} | Vitinerario Travel Details";
    int langId = LanguageHelper.GetCurrentLangId(Context);

    var cultureInfo = langId == 2 ? new System.Globalization.CultureInfo("it-IT") : new System.Globalization.CultureInfo("en-US");

    // --- CONTROLLO EMAIL O TELEFONO ---
    string rawContactInfo = Model.Event.ContactInfo ?? "";
    bool isEmail = rawContactInfo.Contains("@");

    // --- TRADUZIONI ---
    string txtStay = langId == 2 ? "Soggiorni" : "Accommodations";
    string txtInclusions = langId == 2 ? "Cosa è incluso" : "What's Included";
    string txtExclusions = langId == 2 ? "Cosa non è incluso" : "What's Not Included";
    string txtAssistance = langId == 2 ? "Serve Aiuto?" : "Need Assistance?";
    string txtAssistanceDesc = langId == 2 ? "Contattaci per maggiori informazioni o prenotazioni." : "Contact us for more information or bookings.";
    string txtDay = langId == 2 ? "Giorno" : "Day";
    string txtAlertWa = langId == 2 ? "Nessun contatto disponibile al momento." : "No contact available at the moment.";
    
    string txtWa = isEmail 
        ? (langId == 2 ? "Invia un'email" : "Send an email") 
        : (langId == 2 ? "Scrivici su WhatsApp" : "Chat on WhatsApp");

    // --- LOGICA TEMPORALE ---
    DateTime finalEndDateTime;
    if (Model.Event.EndDate.HasValue)
    {
        finalEndDateTime = Model.Event.EndDate.Value.Date;
        if (Model.Event.EndTime != null && TimeSpan.TryParse(Model.Event.EndTime.ToString(), out TimeSpan parsedEndTime))
        {
            finalEndDateTime = finalEndDateTime.Add(parsedEndTime);
        }
        else
        {
            finalEndDateTime = finalEndDateTime.Add(new TimeSpan(23, 59, 59));
        }
    }
    else
    {
        DateTime baseStartDate = Model.Event.StartDate != default(DateTime) ? Model.Event.StartDate : Model.Event.EventDate;
        finalEndDateTime = baseStartDate.Date;
        if (Model.Event.StartTime != null && TimeSpan.TryParse(Model.Event.StartTime.ToString(), out TimeSpan parsedStartTime))
        {
            finalEndDateTime = finalEndDateTime.Add(parsedStartTime);
        }
        else
        {
            finalEndDateTime = finalEndDateTime.Add(new TimeSpan(23, 59, 59));
        }
    }

    bool isEventPast = DateTime.Now > finalEndDateTime;

   // --- LOGICA DATE FORMATTATE ---
    string dateRange = "";
    if (Model.Event.EndDate.HasValue && Model.Event.EndDate.Value > Model.Event.StartDate)
    {
        dateRange = $"{Model.Event.StartDate.ToString("dd MMMM", cultureInfo)} — {Model.Event.EndDate.Value.ToString("dd MMMM yyyy", cultureInfo)}";
    }
    else
    {
        dateRange = Model.Event.StartDate.ToString("dd MMMM yyyy", cultureInfo);
    }

    // Forza le iniziali maiuscole per i mesi (es. "settembre" -> "Settembre")
    dateRange = cultureInfo.TextInfo.ToTitleCase(dateRange);
    int days = Model.Trip?.DurationDays ?? 1;
    int nights = Model.Trip?.DurationNights ?? 0;
    string duration = langId == 2 ? $"{days} Giorni / {nights} Notti" : $"{days} Days / {nights} Nights";

    string bgImage = !string.IsNullOrEmpty(Model.Event.HeroImage) ? Model.Event.HeroImage : Model.Event.CoverImage;
    if (string.IsNullOrEmpty(bgImage)) 
    {
        bgImage = "https://images.unsplash.com/photo-1523362628745-0c100150b504?q=80&w=2000&auto=format&fit=crop";
    }

    string priceDisplay = Model.Event.Price > 0 ? Model.Event.Price.ToString("N0", cultureInfo) + " €" : (langId == 2 ? "Su Richiesta" : "On Request");

    // --- LINK PRENOTAZIONE ---
    var bookingPhoneRaw = rawContactInfo.Replace(" ", "").Replace("-", "").Replace("/", "").Replace("(", "").Replace(")", "");
    var isMobileNum = bookingPhoneRaw.StartsWith("3") || bookingPhoneRaw.StartsWith("+393") || bookingPhoneRaw.StartsWith("393");
    string bookingHref = isMobileNum 
        ? $"https://wa.me/{(bookingPhoneRaw.StartsWith("39") ? bookingPhoneRaw : "39" + bookingPhoneRaw).Replace("+", "")}" 
        : (!string.IsNullOrEmpty(bookingPhoneRaw) ? $"tel:{(bookingPhoneRaw.StartsWith("+") ? bookingPhoneRaw : "+39" + bookingPhoneRaw)}" : "#");

    var buttonStyles = isEventPast 
        ? "border border-primary/50 text-primary/50 bg-[#121212] cursor-not-allowed" 
        : "bg-primary hover:bg-primary/90 text-white shadow-lg hover:shadow-primary/40 transform hover:-translate-y-0.5 cursor-pointer";
}

@section TailwindConfig {
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#D31A53",
                        "deep-charcoal": "#121212",
                        "dark-card": "#1a1a1a"
                    },
                    fontFamily: {
                        "display": ["Noto Serif", "serif"]
                    }
                }
            }
        }
    </script>
}

@section Styles {
    <style type="text/tailwindcss">
        @@layer base {
            body {
                @@apply bg-[#121212] text-white;
            }
        }
    </style>
    <style>
        html { scroll-behavior: smooth; }
        details > summary::-webkit-details-marker { display: none; }
        details summary { list-style: none; outline: none; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .narrative-fix * { -webkit-text-stroke: 0px !important; }
    </style>
}

<div id="booking-bar" class="fixed top-0 left-0 right-0 z-[45] bg-dark-card/95 backdrop-blur-xl border-b border-stone-800 py-3 md:py-4 shadow-[0_10px_30px_rgba(0,0,0,0.5)] transition-all duration-200">
    <div class="max-w-7xl mx-auto px-4 md:px-12 flex items-center justify-between gap-4">
        
        <div class="flex items-center gap-8 flex-1 min-w-0">
            
            <div class="block flex-1 lg:flex-none max-w-full lg:max-w-sm min-w-0">
                <p class="hidden lg:block text-[10px] text-primary uppercase font-bold tracking-widest leading-none mb-1">
                    @(langId == 2 ? "Il tuo Vitinerario" : "Your Vitinerario")
                </p>
                <div class="text-[11px] md:text-sm font-display font-black text-white uppercase tracking-tight truncate leading-tight" title="@Model.Event.Title.Replace("<br>", " ").Replace("<BR>", " ")">
                    @Html.Raw(Model.Event.Title.Replace("<br>", " ").Replace("<BR>", " "))
                </div>
                
                <!-- Solo la data su Mobile, niente maiuscolo forzato, niente prezzo tagliato -->
                <div class="block lg:hidden text-[10px] md:text-[11px] mt-1 text-stone-400 truncate">
                    @dateRange
                </div>
            </div>

            <div class="hidden lg:flex items-center gap-6 border-l border-stone-800 pl-6 shrink-0">
                <div>
                    <p class="text-[9px] text-stone-500 uppercase font-bold tracking-widest leading-none mb-1">
                        @(langId == 2 ? "Quando" : "When")
                    </p>
                    <p class="text-xs text-white">@dateRange</p>
                </div>
                <div>
                    <p class="text-[9px] text-stone-500 uppercase font-bold tracking-widest leading-none mb-1">
                        @(langId == 2 ? "Partenza" : "Departure")
                    </p>
                    <p class="text-xs text-white truncate max-w-[120px]" title="@(Model.Trip?.DepartureCity ?? "TBA")">
                        @(Model.Trip?.DepartureCity ?? "TBA")
                    </p>
                </div>
                <div>
                    <p class="text-[9px] text-stone-500 uppercase font-bold tracking-widest leading-none mb-1">
                        @(langId == 2 ? "Arrivo" : "Arrival")
                    </p>
                    <p class="text-xs text-white truncate max-w-[120px]" title="@(Model.Trip?.ArrivalCity ?? Model.Event.Location ?? "TBA")">
                        @(Model.Trip?.ArrivalCity ?? Model.Event.Location ?? "TBA")
                    </p>
                </div>
            </div>
        </div>
        
        <div class="flex items-center gap-4 md:gap-8 justify-end shrink-0">
            
            <div class="text-right hidden lg:block shrink-0">
                <p class="text-[9px] text-stone-500 uppercase font-bold tracking-widest leading-none mb-1">
                    @(langId == 2 ? "A partire da" : "Starting from")
                </p>
                <p class="text-xl font-bold text-white">@priceDisplay</p>
            </div>

            <button type="button" onclick="handleBookingClick()" class="@buttonStyles py-2.5 px-4 md:py-3 md:px-8 rounded-sm transition-all text-[9px] md:text-[10px] uppercase tracking-widest shrink-0">
                @(langId == 2 ? "PRENOTA ORA" : "RESERVE NOW")
            </button>
        </div>
    </div>
</div>

<header class="relative h-[85vh] overflow-hidden flex items-end pb-24 mt-[80px]">
    <div class="absolute inset-0">
        <img src="@bgImage" alt="@Model.Event.Title" class="w-full h-full object-cover">
        <div class="absolute inset-0 bg-gradient-to-t from-[#121212] via-transparent to-transparent"></div>
    </div>

    <div class="absolute top-24 md:top-32 left-0 w-full z-20">
        <div class="container mx-auto px-12">
            <a href="@Url.Action("Events", "Home")" class="group inline-flex items-center text-[10px] uppercase tracking-[0.2em] font-bold text-white bg-black/40 backdrop-blur-md border border-white/10 px-5 py-2.5 rounded-full hover:bg-primary hover:border-primary transition-all duration-300 w-fit">
                <span class="material-symbols-outlined text-base mr-3 group-hover:-translate-x-1 transition-transform duration-300">arrow_back</span>
                @(langId == 2 ? "Torna agli Eventi" : "Back to Events")
            </a>
        </div>
    </div>

    <div class="container mx-auto px-12 relative z-10">
        <div class="max-w-4xl">
            <div class="flex items-center gap-4 mb-6">
                <div class="bg-primary text-white text-[10px] md:text-xs font-black uppercase tracking-[0.2em] px-3 py-1.5 rounded-sm">
                    @dateRange
                </div>
                <div class="w-px h-4 bg-white/20"></div>
                <div class="text-stone-400 text-[10px] md:text-xs font-bold uppercase tracking-[0.2em]">
                    @duration
                </div>
            </div>
            
            <h1 class="text-6xl md:text-8xl text-white font-black leading-[0.9] uppercase font-display tracking-tighter">
                @Html.Raw(Model.Event.Title)
            </h1>
        </div>
    </div>
</header>

<main class="container mx-auto px-6 md:px-12 py-16 max-w-6xl">
    
    <!-- SEZIONE NARRATIVA -->
    <div class="mb-24 text-left">
        @* <h3 class="text-xs md:text-sm font-medium text-primary uppercase tracking-[0.4em] mb-8 font-sans">
            @(langId == 2 ? "La Narrativa" : "The Narrative")
        </h3> *@
        <div class="prose prose-invert max-w-none text-[15px] md:text-[17px] font-light leading-[1.8] text-stone-300 narrative-fix font-sans">
            @Html.Raw(Model.Event.Description)
        </div>
    </div>

    @if (Model.Itinerary != null && Model.Itinerary.Any())
    {
        <div id="itinerary" class="mb-24 scroll-mt-32">
            
            <h3 class="text-xs md:text-sm font-medium text-primary uppercase tracking-[0.4em] mb-12 font-sans">
                @(langId == 2 ? "Dettagli del Viaggio" : "Trip Details")
            </h3>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20">
                
                <!-- COLONNA SINISTRA: RECAP E MENÙ RAPIDO -->
                <div class="lg:col-span-4 space-y-6">

                    @if (Model.Event.HasVariantPrice && Model.VariantPrices != null && Model.VariantPrices.Any())
                    {
                        <div class="relative w-full text-left border-b border-white/5 pb-4 mb-4" id="custom-dropdown-container">
                            <span class="block text-stone-500 text-[10px] font-bold uppercase tracking-[0.2em] mb-3">@(langId == 2 ? "Opzione di partecipazione" : "Participation option")</span>
                            
                            @{
                                var primaVariante = Model.VariantPrices.First();
                                string primaPrice = $"€{primaVariante.Price.ToString("N0", cultureInfo)}";
                            }
                            
                            <button type="button" id="dropdown-button" class="flex items-center justify-between w-full bg-transparent text-white py-2 focus:outline-none cursor-pointer group gap-4">
                                <span id="dropdown-selected-desc" class="text-[11px] xl:text-[12px] font-bold uppercase tracking-[0.2em] text-left leading-relaxed text-stone-300 group-hover:text-white transition-colors pr-2">
                                    @primaVariante.Description
                                </span>
                                <div class="flex items-center gap-3 shrink-0">
                                    <span id="dropdown-selected-price" class="text-xl font-bold text-white whitespace-nowrap">
                                        @primaPrice
                                    </span>
                                    <span class="material-symbols-outlined text-primary transition-transform duration-300 group-hover:translate-y-1" id="dropdown-arrow">expand_more</span>
                                </div>
                            </button>

                            <div id="dropdown-menu" class="absolute z-50 w-full mt-4 origin-top rounded-xl bg-[#1a1a1a] border border-white/10 shadow-[0_10px_40px_rgba(0,0,0,0.8)] opacity-0 invisible transition-all duration-200 transform scale-95 pointer-events-none overflow-hidden">
                                <div class="flex flex-col" role="menu">
                                    @{ bool isFirstVariant = true; }
                                    @foreach (var variant in Model.VariantPrices)
                                    {
                                        string vPrice = $"€{variant.Price.ToString("N0", cultureInfo)}";
                                        string cssClasses = isFirstVariant 
                                            ? "text-white bg-primary/10 hover:bg-primary/20" 
                                            : "text-stone-400 hover:text-white hover:bg-white/5";
                                        
                                        <button type="button" class="dropdown-option flex w-full items-center justify-between px-6 py-4 text-[11px] xl:text-[12px] font-bold uppercase tracking-[0.2em] text-left border-b border-white/5 transition-colors @cssClasses" data-desc="@variant.Description" data-price="@vPrice">
                                            <span class="leading-relaxed pr-4">@variant.Description</span>
                                            <span class="font-normal opacity-80 whitespace-nowrap">@vPrice</span>
                                        </button>
                                        isFirstVariant = false;
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center justify-between py-5 border-b border-white/5 mb-4">
                            <span class="text-stone-500 text-[10px] font-bold uppercase tracking-[0.2em]">@(langId == 2 ? "Quota per persona" : "Rate per guest")</span>
                            <span class="text-2xl font-bold text-white">@priceDisplay</span>
                        </div>
                    }

                    <div class="flex items-center justify-between py-5 border-b border-white/5 mb-8">
                        <span class="text-stone-500 text-[10px] font-bold uppercase tracking-[0.2em]">@(langId == 2 ? "Durata" : "Duration")</span>
                        <span class="text-base font-bold text-white">@duration</span>
                    </div>

                    <!-- BOTTONE DOWNLOAD: TRASPARENTE CON BORDO ROSA LEGGERO -->
                    @if (!string.IsNullOrEmpty(Model.Event.ProgramPdf))
                    {
                        <div class="pt-4">
                            <a href="@Model.Event.ProgramPdf" target="_blank" class="group flex items-center justify-center gap-3 w-full bg-transparent border border-primary/30 text-primary font-bold py-4 px-6 rounded-xl hover:border-primary hover:text-white hover:bg-primary/10 transition-all cursor-pointer">
                                <span class="material-symbols-outlined text-[20px] group-hover:-translate-y-1 transition-transform duration-300">download</span>
                                <span class="text-[11px] xl:text-[12px] uppercase tracking-[0.2em] pt-0.5">
                                    @(langId == 2 ? "Scarica il Programma" : "Download Itinerary")
                                </span>
                            </a>
                        </div>
                    }

                    <!-- MENU LATERALE MINIMALE -->
<nav class="hidden lg:flex flex-col border-l border-primary/50 my-8 py-2 gap-1" id="page-nav">
    <a href="#itinerary" class="nav-link flex items-center gap-4 px-6 py-3 text-stone-500 hover:text-white font-bold text-[11px] uppercase tracking-[0.2em] transition-colors">
        <span class="material-symbols-outlined text-[18px]">calendar_month</span>
        @(langId == 2 ? "L'Itinerario" : "The Itinerary")
    </a>
    
    @if (Model.Stays != null && Model.Stays.Any())
    {
        <a href="#stay" class="nav-link flex items-center gap-4 px-6 py-3 text-stone-500 hover:text-white font-bold text-[11px] uppercase tracking-[0.2em] transition-colors">
            <span class="material-symbols-outlined text-[18px]">bed</span>
            @txtStay
        </a>
    }
    
    @if (Model.Event.HasNeeds && Model.EventNeeds != null && Model.EventNeeds.Any())
    {
        <a href="#needs" class="nav-link flex items-center gap-4 px-6 py-3 text-stone-500 hover:text-white font-bold text-[11px] uppercase tracking-[0.2em] transition-colors">
            <span class="material-symbols-outlined text-[18px]">info</span>
            @(langId == 2 ? "Informazioni Essenziali" : "Essential Information")
        </a>
    }

    @if (Model.Musts != null && Model.Musts.Any())
    {
        <a href="#experiences" class="nav-link flex items-center gap-4 px-6 py-3 text-stone-500 hover:text-white font-bold text-[11px] uppercase tracking-[0.2em] transition-colors">
            <span class="material-symbols-outlined text-[18px]">wine_bar</span>
            @(langId == 2 ? "Esperienze" : "Experiences")
        </a>
    }
</nav>
                    <!-- BOTTONE RICHIESTA INFO QUADRATO -->
                    <button type="button" onclick="handleBookingClick()" class="w-full bg-primary hover:bg-primary/90 text-white font-bold text-[11px] px-8 py-5 rounded-sm uppercase tracking-[0.15em] transition-all cursor-pointer shadow-lg hover:shadow-primary/30">
                        @(langId == 2 ? "RICHIEDI INFORMAZIONI" : "REQUEST INFORMATION")
                    </button>

                </div>

                <!-- COLONNA DESTRA: TIMELINE -->
                <div class="lg:col-span-8">
                    
                    <div class="relative">
                        <div class="absolute left-[11px] top-6 bottom-6 w-[1px] bg-primary z-0"></div>

                        @{ bool isFirstDay = true; }
                        @foreach (var itDay in Model.Itinerary)
                        {
                            <details class="group relative z-10 mb-2" @(isFirstDay ? "open" : "")>
                                <summary class="flex items-center justify-between cursor-pointer py-4 outline-none list-none border-b border-stone-800/50 group-open:border-transparent transition-colors pr-4">
                                    <div class="flex items-center gap-6 flex-1">
                                        <div class="relative w-6 h-6 bg-[#121212] flex items-center justify-center shrink-0 z-10">
                                            <div class="w-2.5 h-2.5 rounded-full bg-stone-500 group-open:bg-primary transition-colors duration-300"></div>
                                        </div>
                                        <div class="flex flex-col md:flex-row md:items-center justify-between w-full">
                                            <h3 class="text-stone-300 group-open:text-white font-bold text-[15px] md:text-lg uppercase tracking-wider transition-colors duration-300">
                                                @txtDay @itDay.Day.DayNumber.ToString("00"): @itDay.Day.Title
                                            </h3>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-4 shrink-0">
                                        <span class="material-symbols-outlined text-stone-600 group-open:text-primary group-open:rotate-180 transition-all duration-300">expand_more</span>
                                    </div>
                                </summary>
                                
                                <div class="ml-[44px] mb-8 mt-2 p-6 md:p-8 bg-[#1a1a1a] border border-white/5 rounded-xl shadow-xl">
                                    @if (!string.IsNullOrEmpty(itDay.Day.Description))
                                    {
                                        <p class="text-stone-400 text-[15px] font-light leading-relaxed mb-6 whitespace-pre-line">
                                            @itDay.Day.Description
                                        </p>
                                    }

                                    @if (!string.IsNullOrEmpty(itDay.Day.Image1) || !string.IsNullOrEmpty(itDay.Day.Image2) || !string.IsNullOrEmpty(itDay.Day.Image3))
                                    {
                                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
                                            @if (!string.IsNullOrEmpty(itDay.Day.Image1))
                                            {
                                                <img src="@itDay.Day.Image1" alt="@itDay.Day.Title" class="w-full aspect-square object-cover rounded-sm border border-white/5" />
                                            }

                                            @if (!string.IsNullOrEmpty(itDay.Day.Image2))
                                            {
                                                <img src="@itDay.Day.Image2" alt="@itDay.Day.Title" class="w-full aspect-square object-cover rounded-sm border border-white/5" />
                                            }

                                            @if (!string.IsNullOrEmpty(itDay.Day.Image3))
                                            {
                                                <img src="@itDay.Day.Image3" alt="@itDay.Day.Title" class="w-full aspect-square object-cover rounded-sm border border-white/5" />
                                            }
                                        </div>
                                    }

                                    @if (itDay.Stops != null && itDay.Stops.Any())
                                    {
                                        <div class="space-y-6">
                                            @foreach (var stop in itDay.Stops)
                                            {
                                                <div class="flex flex-col md:flex-row gap-2 md:gap-6 border-t border-white/5 pt-6 first:border-0 first:pt-0">
                                                    <span class="font-bold text-xs tabular-nums uppercase text-primary shrink-0 mt-1">
                                                        @stop.Time.ToString(@"hh\:mm")
                                                    </span>
                                                    <div>
                                                        <h4 class="text-white font-bold uppercase tracking-wider text-sm mb-1 leading-tight">
                                                            @stop.Title
                                                        </h4>
                                                        @if (!string.IsNullOrEmpty(stop.Description))
                                                        {
                                                            <p class="text-stone-400 text-xs font-light leading-relaxed whitespace-pre-line">
                                                                @stop.Description
                                                            </p>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </details>
                            isFirstDay = false;
                        }
                    </div>
                </div>

            </div>
        </div>
    }

    <!-- STAY SECTION -->
   @if (Model.Stays != null && Model.Stays.Any())
    {
        <div id="stay" class="mb-32 pt-16 border-t border-stone-800 scroll-mt-32">
            <h3 class="text-xs md:text-sm font-medium text-primary uppercase tracking-[0.4em] mb-12 font-sans">
                @txtStay
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var stay in Model.Stays.OrderBy(s => s.OrderIndex))
                {
                    <div class="bg-dark-card border border-stone-800 rounded-xl overflow-hidden group">
                        <div class="aspect-[16/9] overflow-hidden">
                            <!-- HO RIMOSSO L'EFFETTO ZOOM DA QUI SOTTO -->
                            <img src="@(!string.IsNullOrEmpty(stay.Image) ? stay.Image : "https://images.unsplash.com/photo-1566665797739-1674de7a421a?q=80&w=800&auto=format&fit=crop")" 
                                 alt="@stay.Name" class="w-full h-full object-cover">
                        </div>
                        <div class="p-6">
                            <h4 class="text-white font-bold uppercase tracking-widest mb-2">@stay.Name</h4>
                            <p class="text-stone-400 text-sm">@Html.Raw(stay.Description ?? stay.Location)</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    
    <!-- ESSENTIAL INFO SECTION -->
    @if (Model.Event.HasNeeds && Model.EventNeeds != null && Model.EventNeeds.Any())
    {
        <div id="needs" class="mb-32 pt-16 border-t border-stone-800 scroll-mt-32">
            <h3 class="text-xs md:text-sm font-medium text-primary uppercase tracking-[0.4em] mb-12 font-sans">
                @(langId == 2 ? "Informazioni Essenziali" : "Essential Information")
            </h3>
            <div class="prose prose-invert max-w-none text-[15px] md:text-[17px] font-light leading-[1.8] text-stone-300 narrative-fix font-sans">
                @foreach (var need in Model.EventNeeds)
                {
                    @Html.Raw(need.Description)
                }
            </div>
        </div>
    }

    <!-- EXPERIENCES SECTION -->
    @if (Model.Musts != null && Model.Musts.Any())
    {
        <div id="experiences" class="grid grid-cols-1 lg:grid-cols-2 gap-24 mb-32 pt-16 border-t border-stone-800 scroll-mt-32">
            @if (Model.Musts.Any(m => m.TypeId == 1))
            {
                <div>
                    <h3 class="text-xs md:text-sm font-medium text-primary uppercase tracking-[0.4em] mb-12 font-sans">@txtInclusions</h3>
                    <ul class="space-y-6">
                        @foreach (var must in Model.Musts.Where(m => m.TypeId == 1))
                        {
                            <li class="flex items-center gap-4">
                                <span class="material-symbols-outlined text-primary">check_circle</span>
                                <span class="text-stone-400 font-light">@must.Text</span>
                            </li>
                        }
                    </ul>
                </div>
            }
            
            @if (Model.Musts.Any(m => m.TypeId == 2))
            {
                <div>
                    <h3 class="text-xs md:text-sm font-medium text-primary uppercase tracking-[0.4em] mb-12 font-sans">@txtExclusions</h3>
                    <ul class="space-y-6">
                        @foreach (var must in Model.Musts.Where(m => m.TypeId == 2))
                        {
                            <li class="flex items-center gap-4">
                                <span class="material-symbols-outlined text-stone-600">cancel</span>
                                <span class="text-stone-500 font-light">@must.Text</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    }

</main>

<div class="container mx-auto px-6 md:px-12 mb-32 max-w-6xl">
    <!-- BLOCCO ASSISTENZA QUADRATO -->
    <div class="p-8 md:p-12 bg-[#1a1a1a] rounded-sm border border-white/5 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-8">
        <div>
            <div class="flex items-center gap-3 mb-3">
                <span class="material-symbols-outlined text-primary text-[28px]">support_agent</span>
                <h3 class="text-lg font-bold text-white uppercase tracking-[0.15em] leading-none pt-1">
                    @txtAssistance
                </h3>
            </div>
            <p class="text-[15px] text-stone-400 font-light mt-2">
                @txtAssistanceDesc
            </p>
        </div>

        <!-- BOTTONE ASSISTENZA QUADRATO -->
        <button type="button" onclick="handleBookingClick()" class="group inline-flex items-center justify-center gap-3 bg-primary hover:bg-primary/90 text-white font-bold text-[11px] px-8 py-4 rounded-sm uppercase tracking-[0.15em] transition-all cursor-pointer shrink-0 w-full md:w-auto">
            @txtWa
            <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
        </button>
    </div>
</div>

@section Scripts {
    <script>
        function handleBookingClick() {
            const isMobileUA = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
            const rawPhone = "@Html.Raw(bookingPhoneRaw)";
            const isEmail = @isEmail.ToString().ToLower();
            
            if (!rawPhone || rawPhone.trim() === "") {
                alert("@Html.Raw(txtAlertWa)");
                return;
            }

            if (isEmail) {
                window.location.href = `mailto:@Html.Raw(rawContactInfo)`;
                return;
            }

            if (isMobileUA) {
                window.location.href = "@Html.Raw(bookingHref)";
            } else {
                if (rawPhone.startsWith("3")) {
                    window.open(`https://web.whatsapp.com/send?phone=39${rawPhone}`, '_blank');
                } else {
                    window.location.href = `tel:+39${rawPhone}`;
                }
            }
        }

        function adjustBookingBar() {
            const mainHeader = document.querySelector('header.fixed.top-0'); 
            const bookingBar = document.getElementById('booking-bar');
            
            if (mainHeader && bookingBar) {
                const headerHeight = mainHeader.offsetHeight;
                bookingBar.style.top = headerHeight + 'px';
            }
        }
        
        window.addEventListener('load', adjustBookingBar);
        window.addEventListener('resize', adjustBookingBar);

        const detailsElements = document.querySelectorAll("#itinerary details");
        detailsElements.forEach((targetDetail) => {
            targetDetail.addEventListener("click", (e) => {
                if (e.target.closest('summary')) {
                    detailsElements.forEach((detail) => {
                        if (detail !== targetDetail) {
                            detail.removeAttribute("open");
                        }
                    });
                }
            });
        });

        // --- SCRIPT PER IL CUSTOM DROPDOWN ---
        document.addEventListener('DOMContentLoaded', () => {
            const button = document.getElementById('dropdown-button');
            const menu = document.getElementById('dropdown-menu');
            
            if (button && menu) {
                const arrow = document.getElementById('dropdown-arrow');
                const selectedDesc = document.getElementById('dropdown-selected-desc');
                const selectedPrice = document.getElementById('dropdown-selected-price');
                const options = document.querySelectorAll('.dropdown-option');
                
                let isDropdownOpen = false;

                function toggleDropdown() {
                    isDropdownOpen = !isDropdownOpen;
                    if (isDropdownOpen) {
                        menu.classList.remove('opacity-0', 'invisible', 'scale-95', 'pointer-events-none');
                        menu.classList.add('opacity-100', 'scale-100');
                        arrow.classList.add('rotate-180');
                        button.classList.add('border-primary');
                    } else {
                        menu.classList.add('opacity-0', 'invisible', 'scale-95', 'pointer-events-none');
                        menu.classList.remove('opacity-100', 'scale-100');
                        arrow.classList.remove('rotate-180');
                        button.classList.remove('border-primary');
                    }
                }

                button.addEventListener('click', toggleDropdown);

                document.addEventListener('click', (e) => {
                    if (!button.contains(e.target) && !menu.contains(e.target) && isDropdownOpen) {
                        toggleDropdown();
                    }
                });

                options.forEach(option => {
                    option.addEventListener('click', () => {
                        const desc = option.getAttribute('data-desc');
                        const price = option.getAttribute('data-price');
                        
                        selectedDesc.textContent = desc;
                        selectedPrice.textContent = price;
                        
                        options.forEach(opt => {
                            opt.classList.remove('text-white', 'bg-primary/10', 'hover:bg-primary/20');
                            opt.classList.add('text-stone-400', 'hover:text-white', 'hover:bg-white/5');
                        });
                        option.classList.remove('text-stone-400', 'hover:text-white', 'hover:bg-white/5');
                        option.classList.add('text-white', 'bg-primary/10', 'hover:bg-primary/20');

                        toggleDropdown();
                    });
                });
            }

            
           // --- SCRIPT PER LO SCROLL SPY AGGIORNATO (Design Minimale) ---
           // --- SCRIPT PER LO SCROLL SPY AGGIORNATO (Design Minimale) ---
const sections = document.querySelectorAll(".scroll-mt-32");
const navLinks = document.querySelectorAll(".nav-link");

if (sections.length > 0 && navLinks.length > 0) {
    window.addEventListener("scroll", () => {
        let current = "";
        sections.forEach((section) => {
            const sectionTop = section.offsetTop;
            if (window.pageYOffset >= sectionTop - 300) {
                current = section.getAttribute("id");
            }
        });

        navLinks.forEach((link) => {
            // Rimuove l'evidenziazione e torna grigio
            link.classList.remove("text-primary", "text-white");
            link.classList.add("text-stone-500");
            
            // Applica il colore rosa se è la sezione attiva
            if (link.getAttribute("href") === `#${current}`) {
                link.classList.remove("text-stone-500");
                link.classList.add("text-primary"); 
            }
        });
    });
}


        });
    </script>
}