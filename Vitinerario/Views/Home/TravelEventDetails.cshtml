@model Vitinerario.Models.TravelEventViewModel

@using Microsoft.AspNetCore.Mvc.Localization
@using Vitinerario.Resources.Views.Shared
@using Vitinerario.Helpers
@inject IViewLocalizer Localizer
@{
    Layout = "_LayoutVitinerario";
    ViewData["Title"] = $"{Model.Event.Title} | Vitinerario Travel Details";

    int langId = LanguageHelper.GetCurrentLangId(Context);

    // --- CONTROLLO EMAIL O TELEFONO ---
    string rawContactInfo = Model.Event.ContactInfo ?? "";
    bool isEmail = rawContactInfo.Contains("@");

    // --- TRADUZIONI ---
    string txtNarrative = langId == 2 ? "La Narrativa" : "The Narrative";
    string txtStay = langId == 2 ? "Soggiorni" : "Accommodations";
    string txtInclusions = langId == 2 ? "Cosa è incluso" : "What's Included";
    string txtExclusions = langId == 2 ? "Non incluso" : "Exclusions";
    string txtAssistance = langId == 2 ? "Serve Aiuto?" : "Need Assistance?";
    string txtAssistanceDesc = langId == 2 ? "Contattaci per maggiori informazioni o prenotazioni." : "Contact us for more information or bookings.";
    string txtMaxGroup = langId == 2 ? "Gruppo Max" : "Max Group";
    string txtGuests = langId == 2 ? "Partecipanti" : "Participants";
    string txtDay = langId == 2 ? "Giorno" : "Day";
    string txtAlertWa = langId == 2 ? "Nessun contatto disponibile al momento." : "No contact available at the moment.";
    
    // Testo dinamico per il bottone in base a email/telefono
    string txtWa = isEmail 
        ? (langId == 2 ? "Invia un'email" : "Send an email") 
        : (langId == 2 ? "Scrivici su WhatsApp" : "Chat on WhatsApp");

    // --- LOGICA TEMPORALE ---
    DateTime finalEndDateTime;
    if (Model.Event.EndDate.HasValue)
    {
        finalEndDateTime = Model.Event.EndDate.Value.Date;
        if (Model.Event.EndTime != null && TimeSpan.TryParse(Model.Event.EndTime.ToString(), out TimeSpan parsedEndTime))
        {
            finalEndDateTime = finalEndDateTime.Add(parsedEndTime);
        }
        else
        {
            finalEndDateTime = finalEndDateTime.Add(new TimeSpan(23, 59, 59));
        }
    }
    else
    {
        DateTime baseStartDate = Model.Event.StartDate != default(DateTime) ? Model.Event.StartDate : Model.Event.EventDate;
        finalEndDateTime = baseStartDate.Date;
        if (Model.Event.StartTime != null && TimeSpan.TryParse(Model.Event.StartTime.ToString(), out TimeSpan parsedStartTime))
        {
            finalEndDateTime = finalEndDateTime.Add(parsedStartTime);
        }
        else
        {
            finalEndDateTime = finalEndDateTime.Add(new TimeSpan(23, 59, 59));
        }
    }

    bool isEventPast = DateTime.Now > finalEndDateTime;

    string dateRange = "";
    if (Model.Event.EndDate.HasValue && Model.Event.EndDate.Value > Model.Event.StartDate)
    {
        dateRange = $"{Model.Event.StartDate.ToString("MMM dd")} — {Model.Event.EndDate.Value.ToString("MMM dd, yyyy")}";
    }
    else
    {
        dateRange = Model.Event.StartDate.ToString("MMM dd, yyyy");
    }

    int days = Model.Trip?.DurationDays ?? 1;
    int nights = Model.Trip?.DurationNights ?? 0;
    string duration = langId == 2 ? $"{days} Giorni / {nights} Notti" : $"{days} Days / {nights} Nights";

    string bgImage = !string.IsNullOrEmpty(Model.Event.HeroImage) ? Model.Event.HeroImage : Model.Event.CoverImage;
    if (string.IsNullOrEmpty(bgImage)) 
    {
        bgImage = "https://images.unsplash.com/photo-1523362628745-0c100150b504?q=80&w=2000&auto=format&fit=crop";
    }

    var cultureInfo = langId == 2 ? new System.Globalization.CultureInfo("it-IT") : new System.Globalization.CultureInfo("en-US");
    string priceDisplay = Model.Event.Price > 0 ? Model.Event.Price.ToString("N0", cultureInfo) + " €" : (langId == 2 ? "Su Richiesta" : "On Request");

    // Preparazione numero per WhatsApp
    var bookingPhoneRaw = rawContactInfo.Replace(" ", "").Replace("-", "").Replace("/", "").Replace("(", "").Replace(")", "");
    var isMobileNum = bookingPhoneRaw.StartsWith("3") || bookingPhoneRaw.StartsWith("+393") || bookingPhoneRaw.StartsWith("393");
    string bookingHref = isMobileNum 
        ? $"https://wa.me/{(bookingPhoneRaw.StartsWith("39") ? bookingPhoneRaw : "39" + bookingPhoneRaw).Replace("+", "")}" 
        : (!string.IsNullOrEmpty(bookingPhoneRaw) ? $"tel:{(bookingPhoneRaw.StartsWith("+") ? bookingPhoneRaw : "+39" + bookingPhoneRaw)}" : "#");

    var buttonStyles = isEventPast 
        ? "border border-primary/50 text-primary/50 bg-[#121212] cursor-not-allowed" 
        : "bg-primary hover:bg-primary/90 text-white shadow-lg hover:shadow-primary/40 transform hover:-translate-y-0.5 cursor-pointer";
}

@section TailwindConfig {
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#D31A53",
                        "deep-charcoal": "#121212",
                        "dark-card": "#1a1a1a"
                    },
                    fontFamily: {
                        "display": ["Noto Serif", "serif"]
                    }
                }
            }
        }
    </script>
}

@section Styles {
    <style type="text/tailwindcss">
        @@layer base {
            body {
                @@apply bg-[#121212] text-white;
            }
        }
    </style>
    <style>
        html { scroll-behavior: smooth; }
        details > summary::-webkit-details-marker { display: none; }
        details summary { list-style: none; outline: none; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        
        .narrative-fix * {
            -webkit-text-stroke: 0px !important;
        }
    </style>
}

<div id="booking-bar" class="fixed top-0 left-0 right-0 z-[45] bg-dark-card/95 backdrop-blur-xl border-b border-stone-800 py-4 shadow-[0_10px_30px_rgba(0,0,0,0.5)] transition-all duration-200">
    <div class="max-w-7xl mx-auto px-6 md:px-12 flex items-center justify-between">
        <div class="flex items-center gap-8 flex-1">
            <div class="hidden lg:block max-w-sm">
                <p class="text-[10px] text-primary uppercase font-bold tracking-widest leading-none mb-1">
                    @(langId == 2 ? "Il tuo Itinerario" : "Current Itinerary")
                </p>
                <div class="text-sm font-display font-black text-white uppercase tracking-tight line-clamp-2 leading-tight" title="@Model.Event.Title">
                    @Model.Event.Title
                </div>
            </div>
            <div class="hidden md:flex items-center gap-6 border-l border-stone-800 pl-6">
                <div>
                    <p class="text-[9px] text-stone-500 uppercase font-bold tracking-widest leading-none mb-1">
                        @(langId == 2 ? "Quando" : "When")
                    </p>
                    <p class="text-xs text-white">@dateRange</p>
                </div>
                <div>
                    <p class="text-[9px] text-stone-500 uppercase font-bold tracking-widest leading-none mb-1">
                        @(langId == 2 ? "Dove" : "Where")
                    </p>
                    <p class="text-xs text-white truncate max-w-[150px]" title="@(Model.Trip?.DepartureCity ?? "TBA")">
                        @(Model.Trip?.DepartureCity ?? "TBA")
                    </p>
                </div>
            </div>
        </div>
        
        <div class="flex items-center gap-4 md:gap-8 justify-end">
            <div class="text-right hidden md:block">
                <p class="text-[9px] text-stone-500 uppercase font-bold tracking-widest leading-none mb-1">
                    @(langId == 2 ? "A partire da" : "Starting from")
                </p>
                <p class="text-xl font-bold text-white">@priceDisplay</p>
            </div>
            <button type="button" onclick="handleBookingClick()" class="@buttonStyles py-3 px-6 md:px-8 rounded-xl transition-all text-[9px] md:text-[10px] uppercase tracking-widest shrink-0">
                @(langId == 2 ? "PRENOTA ORA" : "RESERVE NOW")
            </button>
        </div>
    </div>
</div>

<header class="relative h-[85vh] overflow-hidden flex items-end pb-24 mt-[80px]">
    <div class="absolute inset-0">
        <img src="@bgImage" alt="@Model.Event.Title" class="w-full h-full object-cover">
        <div class="absolute inset-0 bg-gradient-to-t from-[#121212] via-transparent to-transparent"></div>
    </div>

    <div class="absolute top-24 md:top-32 left-0 w-full z-20">
        <div class="container mx-auto px-12">
            <a href="@Url.Action("Events", "Home")" class="group inline-flex items-center text-[10px] uppercase tracking-widest-plus font-bold text-white bg-black/40 backdrop-blur-md border border-white/10 px-5 py-2.5 rounded-full hover:bg-primary hover:border-primary transition-all duration-300 w-fit">
                <span class="material-symbols-outlined text-base mr-3 group-hover:-translate-x-1 transition-transform duration-300">arrow_back</span>
                @(langId == 2 ? "Torna agli Eventi" : "Back to Events")
            </a>
        </div>
    </div>

    <div class="container mx-auto px-12 relative z-10">
        <div class="max-w-4xl">
            <div class="flex items-center gap-4 mb-6">
                <div class="bg-primary text-white text-[10px] md:text-xs font-black uppercase tracking-[0.2em] px-3 py-1.5 rounded-sm">
                    @dateRange
                </div>
                <div class="w-px h-4 bg-white/20"></div>
                <div class="text-stone-400 text-[10px] md:text-xs font-bold uppercase tracking-[0.2em]">
                    @duration
                </div>
            </div>
            
            <h1 class="text-6xl md:text-8xl text-white font-black leading-[0.9] uppercase font-display tracking-tighter">
                @Html.Raw(Model.Event.Title)
            </h1>
        </div>
    </div>
</header>

<section class="container mx-auto px-12 -mt-12 relative z-20">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-0 bg-dark-card shadow-2xl rounded-xl overflow-hidden border border-stone-800">
        <div class="p-8 border-b md:border-b-0 md:border-r border-stone-800 flex flex-col justify-start h-full">
            <span class="text-primary text-xs uppercase tracking-widest mb-4 font-bold block min-h-[1rem]">@(langId == 2 ? "Partenza" : "Departure")</span>
            <p class="text-xl font-bold text-white">@(Model.Trip?.DepartureCity ?? (langId == 2 ? "Da definire" : "TBA"))</p>
        </div>
        <div class="p-8 border-b md:border-b-0 md:border-r border-stone-800 flex flex-col justify-start h-full">
            <span class="text-primary text-xs uppercase tracking-widest mb-4 font-bold block min-h-[1rem]">@(langId == 2 ? "Arrivo" : "Arrival")</span>
            <p class="text-xl font-bold text-white">@(Model.Trip?.ArrivalCity ?? Model.Event.Location ?? (langId == 2 ? "Da definire" : "TBA"))</p>
        </div>
        <div class="p-8 border-b md:border-b-0 md:border-r border-stone-800 flex flex-col justify-start h-full">
            <span class="text-primary text-xs uppercase tracking-widest mb-4 font-bold block min-h-[1rem]">@(langId == 2 ? "Durata" : "Duration")</span>
            <p class="text-xl font-bold text-white">@duration</p>
        </div>
        <div class="p-8 bg-dark-card flex flex-col justify-start h-full">
            <span class="text-primary text-xs uppercase tracking-widest mb-4 font-bold block min-h-[1rem]">@txtMaxGroup</span>
            <p class="text-xl font-bold text-white">@(Model.Trip?.MaxGuests.ToString() ?? "-") @txtGuests</p>
        </div>
    </div>
</section>

<main class="container mx-auto px-6 md:px-12 py-24 max-w-6xl">
    <div class="mb-24 text-left">
        <h3 class="text-[10px] font-bold mb-8 text-primary uppercase tracking-[0.2em]">
            @txtNarrative
        </h3>
        <div class="prose prose-invert max-w-none text-lg leading-relaxed text-[#A8A29E] narrative-fix font-sans">
            @Html.Raw(Model.Event.Description)
        </div>
    </div>

    @if (Model.Itinerary != null && Model.Itinerary.Any())
    {
        <div id="itinerary" class="mb-32 pt-16 border-t border-stone-800">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20">
                
                <!-- COLONNA SINISTRA: ORA CONTIENE I "TIERS" CON CUSTOM DROPDOWN E BOTTONE PDF -->
                <div class="lg:col-span-4 space-y-10">
                    <div>
                        <h3 class="text-[10px] font-bold mb-4 text-primary uppercase tracking-[0.2em]">
                            @(langId == 2 ? "Investimento" : "Investment")
                        </h3>
                        <h2 class="text-4xl md:text-5xl font-black text-white uppercase tracking-tighter mb-4 font-display">
                            @(langId == 2 ? "LIVELLI DI SPEDIZIONE" : "EXPEDITION TIERS")
                        </h2>
                        <p class="text-stone-400 text-sm leading-relaxed mb-8">
                            @(langId == 2 
                                ? "Seleziona il livello di immersione su misura per le tue preferenze. Ogni livello mantiene il nostro rigoroso massimo di 8 ospiti per una totale intimità." 
                                : "Select the level of immersion tailored to your preferences. Each tier maintains our strict 8-guest maximum for total intimacy.")
                        </p>
                    </div>

                    <div class="relative group">
                        <label class="block text-[10px] font-bold tracking-[0.2em] text-stone-500 uppercase mb-3 ml-1">
                            @(langId == 2 ? "Seleziona il tuo Livello" : "Select Your Tier")
                        </label>
                        
                        <!-- CUSTOM DROPDOWN -->
                        <div class="relative w-full text-left" id="custom-dropdown-container">
                            <!-- Pulsante che apre il menu -->
                            <button type="button" id="dropdown-button" class="flex items-center justify-between w-full bg-[#1a1a1a] border border-white/10 text-white font-bold py-5 px-6 rounded-xl hover:border-primary/50 transition-all focus:outline-none cursor-pointer">
                                <span id="dropdown-selected-text" class="tracking-widest uppercase text-[12px] xl:text-[13px]">STANDARD EXPEDITION — €12,400</span>
                                <span class="material-symbols-outlined text-primary transition-transform duration-300" id="dropdown-arrow">expand_more</span>
                            </button>

                            <!-- Lista delle opzioni (Inizialmente nascosta) -->
                            <div id="dropdown-menu" class="absolute z-50 w-full mt-2 origin-top rounded-xl bg-[#1a1a1a] border border-white/10 shadow-[0_10px_40px_rgba(0,0,0,0.8)] opacity-0 invisible transition-all duration-200 transform scale-95 pointer-events-none overflow-hidden">
                                <div class="flex flex-col" role="menu">
                                    <!-- Opzione 1 -->
                                    <button type="button" class="dropdown-option flex w-full items-center justify-between px-6 py-4 text-[11px] xl:text-[12px] font-bold text-white bg-primary/10 hover:bg-primary/20 transition-colors uppercase tracking-widest text-left border-b border-white/5" data-text="STANDARD EXPEDITION — €12,400">
                                        <span>Standard Expedition</span>
                                        <span class="text-stone-400 font-normal">€12,400 PP</span>
                                    </button>
                                    <!-- Opzione 2 -->
                                    <button type="button" class="dropdown-option flex w-full items-center justify-between px-6 py-4 text-[11px] xl:text-[12px] font-bold text-stone-400 hover:text-white hover:bg-white/5 transition-colors uppercase tracking-widest text-left border-b border-white/5" data-text="PREMIUM COLLECTOR — €18,200">
                                        <span>Premium Collector</span>
                                        <span class="text-stone-400 font-normal">€18,200 PP</span>
                                    </button>
                                    <!-- Opzione 3 -->
                                    <button type="button" class="dropdown-option flex w-full items-center justify-between px-6 py-4 text-[11px] xl:text-[12px] font-bold text-stone-400 hover:text-white hover:bg-white/5 transition-colors uppercase tracking-widest text-left" data-text="ULTIMATE VIP — €26,500">
                                        <span>Ultimate VIP</span>
                                        <span class="text-stone-400 font-normal">€26,500 PP</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- BOTTONE DOWNLOAD PROGRAMMA (DINAMICO DA DB) -->
                        @if (Model.Event.Links != null && Model.Event.Links.Any())
                        {
                            string programLink = Model.Event.Links.First().LinkUrl;
                            <div class="mt-6">
                                <a href="@programLink" target="_blank" class="group flex items-center justify-center gap-3 w-full bg-transparent border border-white/20 text-white font-bold py-4 px-6 rounded-xl hover:border-primary hover:bg-primary/10 transition-all cursor-pointer">
                                    <span class="material-symbols-outlined text-primary text-[20px] group-hover:-translate-y-1 transition-transform duration-300">download</span>
                                    <span class="text-[11px] xl:text-[12px] uppercase tracking-widest pt-0.5">
                                        @(langId == 2 ? "Scarica il Programma" : "Download the Program")
                                    </span>
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <!-- COLONNA DESTRA: TIMELINE ITINERARIO -->
                <div class="lg:col-span-8">
                    <div class="relative">
                        <div class="absolute left-[11px] top-6 bottom-6 w-[1px] bg-primary z-0"></div>

                        @{ bool isFirstDay = true; }
                        @foreach (var itDay in Model.Itinerary)
                        {
                            <details class="group relative z-10 mb-2" @(isFirstDay ? "open" : "")>
                                <summary class="flex items-center justify-between cursor-pointer py-4 outline-none list-none border-b border-stone-800/50 group-open:border-transparent transition-colors pr-4">
                                    <div class="flex items-center gap-6 flex-1">
                                        <div class="relative w-6 h-6 bg-[#121212] flex items-center justify-center shrink-0 z-10">
                                            <div class="w-2.5 h-2.5 rounded-full bg-stone-500 group-open:bg-primary transition-colors duration-300"></div>
                                        </div>
                                        <div class="flex flex-col md:flex-row md:items-center justify-between w-full">
                                            <h3 class="text-stone-300 group-open:text-white font-bold text-[15px] md:text-lg uppercase tracking-wider transition-colors duration-300">
                                                @txtDay @itDay.Day.DayNumber.ToString("00"): @itDay.Day.Title
                                            </h3>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-4 shrink-0">
                                        <span class="material-symbols-outlined text-stone-600 group-open:text-primary group-open:rotate-180 transition-all duration-300">expand_more</span>
                                    </div>
                                </summary>
                                
                                <div class="ml-[44px] mb-8 mt-2 p-6 md:p-8 bg-[#1a1a1a] border border-white/5 rounded-xl shadow-xl">
                                    @if (!string.IsNullOrEmpty(itDay.Day.Description))
                                    {
                                        <p class="text-stone-400 text-[15px] font-light leading-relaxed mb-6 whitespace-pre-line">
                                            @itDay.Day.Description
                                        </p>
                                    }

                                    <!-- AGGIORNAMENTO IMMAGINI DINAMICHE DA DB -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
    @if (!string.IsNullOrEmpty(itDay.Day.Image1))
    {
        <img src="@itDay.Day.Image1" alt="@itDay.Day.Title" class="w-full aspect-square object-cover rounded-sm border border-white/5" />
    }

    @if (!string.IsNullOrEmpty(itDay.Day.Image2))
    {
        <img src="@itDay.Day.Image2" alt="@itDay.Day.Title" class="w-full aspect-square object-cover rounded-sm border border-white/5" />
    }

    @if (!string.IsNullOrEmpty(itDay.Day.Image3))
    {
        <img src="@itDay.Day.Image3" alt="@itDay.Day.Title" class="w-full aspect-square object-cover rounded-sm border border-white/5" />
    }
</div>

                                    @if (itDay.Stops != null && itDay.Stops.Any())
                                    {
                                        <div class="space-y-6">
                                            @foreach (var stop in itDay.Stops)
                                            {
                                                <div class="flex flex-col md:flex-row gap-2 md:gap-6 border-t border-white/5 pt-6 first:border-0 first:pt-0">
                                                    <span class="font-bold text-xs tabular-nums uppercase text-primary shrink-0 mt-1">
                                                        @stop.Time.ToString(@"hh\:mm")
                                                    </span>
                                                    <div>
                                                        <h4 class="text-white font-bold uppercase tracking-wider text-sm mb-1 leading-tight">
                                                            @stop.Title
                                                        </h4>
                                                        @if (!string.IsNullOrEmpty(stop.Description))
                                                        {
                                                            <p class="text-stone-400 text-xs font-light leading-relaxed whitespace-pre-line">
                                                                @stop.Description
                                                            </p>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </details>
                            isFirstDay = false;
                        }
                    </div>
                </div>

            </div>
        </div>
    }

    @if (Model.Stays != null && Model.Stays.Any())
    {
        <div id="stay" class="mb-32 pt-16 border-t border-stone-800">
            <h3 class="text-2xl font-bold mb-8 text-white flex items-center uppercase tracking-widest">
                <span class="w-8 h-px bg-primary mr-4"></span>
                @txtStay
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var stay in Model.Stays.OrderBy(s => s.OrderIndex))
                {
                    <div class="bg-dark-card border border-stone-800 rounded-xl overflow-hidden group">
                        <div class="aspect-[16/9] overflow-hidden">
                            <img src="@(!string.IsNullOrEmpty(stay.Image) ? stay.Image : "https://images.unsplash.com/photo-1566665797739-1674de7a421a?q=80&w=800&auto=format&fit=crop")" 
                                 alt="@stay.Name" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700">
                        </div>
                        <div class="p-6">
                            <h4 class="text-white font-bold uppercase tracking-widest mb-2">@stay.Name</h4>
                            <p class="text-stone-400 text-sm">@(stay.Description ?? stay.Location)</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (Model.Musts != null && Model.Musts.Any())
    {
        <div id="experiences" class="grid grid-cols-1 lg:grid-cols-2 gap-24 mb-32 pt-16 border-t border-stone-800">
            @if (Model.Musts.Any(m => m.TypeId == 1))
            {
                <div>
                    <h3 class="text-2xl font-black text-white mb-12 uppercase tracking-tighter font-display">@txtInclusions</h3>
                    <ul class="space-y-6">
                        @foreach (var must in Model.Musts.Where(m => m.TypeId == 1))
                        {
                            <li class="flex items-center gap-4">
                                <span class="material-symbols-outlined text-primary">check_circle</span>
                                <span class="text-stone-400 font-light">@must.Text</span>
                            </li>
                        }
                    </ul>
                </div>
            }
            
            @if (Model.Musts.Any(m => m.TypeId == 2))
            {
                <div>
                    <h3 class="text-2xl font-black text-white mb-12 uppercase tracking-tighter font-display">@txtExclusions</h3>
                    <ul class="space-y-6">
                        @foreach (var must in Model.Musts.Where(m => m.TypeId == 2))
                        {
                            <li class="flex items-center gap-4">
                                <span class="material-symbols-outlined text-stone-600">cancel</span>
                                <span class="text-stone-500 font-light">@must.Text</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    }

</main>

<div class="container mx-auto px-6 md:px-12 mb-32 max-w-6xl">
    <div class="p-8 md:p-12 bg-[#1a1a1a] rounded-xl border border-white/5 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-8">
        <div>
            <div class="flex items-center gap-3 mb-3">
                <span class="material-symbols-outlined text-primary text-[28px]">support_agent</span>
                <h3 class="text-lg font-bold text-white uppercase tracking-[0.15em] leading-none pt-1">
                    @txtAssistance
                </h3>
            </div>
            <p class="text-[15px] text-stone-400 font-light mt-2">
                @txtAssistanceDesc
            </p>
        </div>

        <button type="button" onclick="handleBookingClick()" class="group inline-flex items-center justify-center gap-3 bg-primary hover:bg-primary/90 text-white font-bold text-[11px] px-8 py-4 rounded-xl uppercase tracking-[0.15em] transition-all cursor-pointer shrink-0 w-full md:w-auto">
            @txtWa
            <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
        </button>
    </div>
</div>

@section Scripts {
    <script>
        const totalLinks = @(Model.Event.Links?.Count ?? 0);
    const firstLink = "@Html.Raw(Model.Event.Links?.FirstOrDefault()?.LinkUrl ?? "NULL - Nessun link trovato")";

    console.log("=== DEBUG LINK EVENTO ===");
    console.log("Numero totale di link trovati:", totalLinks);
    console.log("Valore del primo link:", firstLink);
    console.log("=== DEBUG DATI EVENTO ===");
    console.log("Titolo Evento:", "@Html.Raw(Model.Event.Title)");
    console.log("Start Date (Raw):", "@Model.Event.StartDate");
    console.log("End Date (Raw):", "@(Model.Event.EndDate.HasValue ? Model.Event.EndDate.Value.ToString() : "NULL - Non impostata")");
    
    // Formattate per una lettura più facile
    console.log("Start Date (ISO):", "@Model.Event.StartDate.ToString("yyyy-MM-dd HH:mm")");
    @if(Model.Event.EndDate.HasValue) {
        <text>console.log("End Date (ISO):", "@Model.Event.EndDate.Value.ToString("yyyy-MM-dd HH:mm")");</text>
    }

        function handleBookingClick() {
            const isMobileUA = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
            const rawPhone = "@Html.Raw(bookingPhoneRaw)";
            const isEmail = @isEmail.ToString().ToLower();
            
            if (!rawPhone || rawPhone.trim() === "") {
                alert("@Html.Raw(txtAlertWa)");
                return;
            }

            if (isEmail) {
                window.location.href = `mailto:@Html.Raw(rawContactInfo)`;
                return;
            }

            if (isMobileUA) {
                window.location.href = "@Html.Raw(bookingHref)";
            } else {
                if (rawPhone.startsWith("3")) {
                    window.open(`https://web.whatsapp.com/send?phone=39${rawPhone}`, '_blank');
                } else {
                    window.location.href = `tel:+39${rawPhone}`;
                }
            }
        }

        function adjustBookingBar() {
            const mainHeader = document.querySelector('header.fixed.top-0'); 
            const bookingBar = document.getElementById('booking-bar');
            
            if (mainHeader && bookingBar) {
                const headerHeight = mainHeader.offsetHeight;
                bookingBar.style.top = headerHeight + 'px';
            }
        }
        
        window.addEventListener('load', adjustBookingBar);
        window.addEventListener('resize', adjustBookingBar);

        const detailsElements = document.querySelectorAll("#itinerary details");
        detailsElements.forEach((targetDetail) => {
            targetDetail.addEventListener("click", (e) => {
                if (e.target.closest('summary')) {
                    detailsElements.forEach((detail) => {
                        if (detail !== targetDetail) {
                            detail.removeAttribute("open");
                        }
                    });
                }
            });
        });

        // --- SCRIPT PER IL CUSTOM DROPDOWN ---
        document.addEventListener('DOMContentLoaded', () => {
            const button = document.getElementById('dropdown-button');
            const menu = document.getElementById('dropdown-menu');
            const arrow = document.getElementById('dropdown-arrow');
            const selectedText = document.getElementById('dropdown-selected-text');
            const options = document.querySelectorAll('.dropdown-option');
            
            let isDropdownOpen = false;

            function toggleDropdown() {
                isDropdownOpen = !isDropdownOpen;
                if (isDropdownOpen) {
                    menu.classList.remove('opacity-0', 'invisible', 'scale-95', 'pointer-events-none');
                    menu.classList.add('opacity-100', 'scale-100');
                    arrow.classList.add('rotate-180');
                    button.classList.add('border-primary');
                } else {
                    menu.classList.add('opacity-0', 'invisible', 'scale-95', 'pointer-events-none');
                    menu.classList.remove('opacity-100', 'scale-100');
                    arrow.classList.remove('rotate-180');
                    button.classList.remove('border-primary');
                }
            }

            // Apri/Chiudi al click
            button.addEventListener('click', toggleDropdown);

            // Chiudi se si clicca fuori
            document.addEventListener('click', (e) => {
                if (!button.contains(e.target) && !menu.contains(e.target) && isDropdownOpen) {
                    toggleDropdown();
                }
            });

            // Gestisci la selezione di un'opzione
            options.forEach(option => {
                option.addEventListener('click', () => {
                    const text = option.getAttribute('data-text');
                    
                    // 1. Aggiorna il testo del bottone principale
                    selectedText.textContent = text;
                    
                    // 2. Aggiorna lo stile delle opzioni (evidenzia la selezionata)
                    options.forEach(opt => {
                        opt.classList.remove('text-white', 'bg-primary/10', 'hover:bg-primary/20');
                        opt.classList.add('text-stone-400', 'hover:text-white', 'hover:bg-white/5');
                    });
                    option.classList.remove('text-stone-400', 'hover:text-white', 'hover:bg-white/5');
                    option.classList.add('text-white', 'bg-primary/10', 'hover:bg-primary/20');

                    // 3. Chiudi il menu
                    toggleDropdown();
                });
            });
        });
    </script>
}