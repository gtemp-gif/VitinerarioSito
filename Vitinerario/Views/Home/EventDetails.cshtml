@model Vitinerario.Models.Dtos.EventDto

@using Microsoft.AspNetCore.Mvc.Localization
@using Vitinerario.Resources.Views.Shared
@inject IViewLocalizer Localizer
@{
    Layout = "_LayoutVitinerario";
    ViewData["Title"] = $"{Model.Title} | Vitinerario Event Details";

    // 1. LOGICA TEMPORALE
    bool isEventPast = DateTime.Now.Date > Model.EventDate.Date;

    // 2. LOGICA PRENOTAZIONE DINAMICA (Basata solo su API)
    // Prendiamo il numero direttamente dal campo contactInfo del JSON
    var bookingPhoneDisplay = Model.ContactInfo;

    // Normalizzazione per i link
    var bookingPhoneRaw = (bookingPhoneDisplay ?? "")
        .Replace(" ", "").Replace("-", "").Replace("/", "").Replace("(", "").Replace(")", "");

    // Verifica se è un cellulare (per WhatsApp)
    var isMobileNum = bookingPhoneRaw.StartsWith("3") || bookingPhoneRaw.StartsWith("+393") || bookingPhoneRaw.StartsWith("393");

    // Generazione link per il bottone
    string bookingHref = isMobileNum
        ? $"https://wa.me/{(bookingPhoneRaw.StartsWith("39") ? bookingPhoneRaw : "39" + bookingPhoneRaw).Replace("+", "")}"
        : (!string.IsNullOrEmpty(bookingPhoneRaw) ? $"tel:{(bookingPhoneRaw.StartsWith("+") ? bookingPhoneRaw : "+39" + bookingPhoneRaw)}" : "#");

    // Classi CSS dinamiche per il bottone
    var buttonStyles = isEventPast
        ? "border border-primary/50 text-primary/50 bg-stone-900 cursor-not-allowed"
        : "bg-primary hover:bg-primary/90 text-white shadow-lg hover:shadow-primary/40 transform hover:-translate-y-0.5 cursor-pointer";

}

@section TailwindConfig {
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "primary": "#D31A53",
                        "deep-charcoal": "#121212",
                        "dark-card": "#1a1a1a"
                    },
                    fontFamily: {
                        "display": ["Noto Serif", "serif"]
                    }
                }
            }
        }
    </script>
}

@section Styles {
    <style type="text/tailwindcss">
        @@layer base {
            body {
                @@apply bg-[#121212] text-white;
            }
        }
    </style>
}
<header class="relative h-[85vh] overflow-hidden flex items-end pb-24">

    @* Sfondo immagine e gradiente *@
    <div class="absolute inset-0">
        <img src="@Model.HeroImage" alt="@Model.Title Venue" class="w-full h-full object-cover">
        <div class="absolute inset-0 bg-gradient-to-t from-[#121212] via-transparent to-transparent"></div>
    </div>

    @* NUOVO POSIZIONAMENTO DEL PULSANTE: Assoluto in alto *@
    @* top-24 su mobile, top-32 su desktop assicurano che sia sempre sotto la navbar *@
    <div class="absolute top-24 md:top-32 left-0 w-full z-20">
        <div class="container mx-auto px-12">
            <a href="@Url.Action("Events", "Home")" class="group inline-flex items-center text-[10px] uppercase tracking-widest-plus font-bold text-white bg-black/40 backdrop-blur-md border border-white/10 px-5 py-2.5 rounded-full hover:bg-primary hover:border-primary transition-all duration-300 w-fit">
                <span class="material-symbols-outlined text-base mr-3 group-hover:-translate-x-1 transition-transform duration-300">arrow_back</span>
                Torna agli Eventi
            </a>
        </div>
    </div>

    @* Contenitore dei testi (resta in basso) *@
    <div class="container mx-auto px-12 relative z-10">
        <div class="max-w-4xl">
            @if (!string.IsNullOrEmpty(Model.Subtitle))
            {
                <span class="inline-block px-4 py-1 mb-6 border border-primary text-primary rounded-full text-sm uppercase tracking-[0.2em] font-bold">@Model.Subtitle</span>
            }

            @{
                // Split del titolo: data sopra, nome sotto
                var headerTitleParts = Model.Title.Split(new[] { " - " }, StringSplitOptions.None);
                var headerDate = headerTitleParts.Length >= 2 ? headerTitleParts[0] : "";
                var headerName = headerTitleParts.Length >= 2 ? headerTitleParts[1] : Model.Title;
            }

            @if (!string.IsNullOrEmpty(headerDate))
            {
                <p class="text-primary text-2xl md:text-3xl font-display italic mb-2">@headerDate</p>
            }

            <h1 class="text-6xl md:text-8xl text-white font-bold leading-[0.9] tracking-tighter uppercase">
                @headerName
            </h1>
        </div>
    </div>
</header>

<section class="container mx-auto px-12 -mt-12 relative z-20">

    <div class="grid grid-cols-1 md:grid-cols-4 gap-0 bg-dark-card shadow-2xl rounded-xl overflow-hidden border border-stone-800">

        <div class="p-8 border-r border-stone-800 flex flex-col justify-start h-full">
            <span class="text-primary text-xs uppercase tracking-widest mb-4 font-bold block min-h-[1rem]">@Localizer[SharedResource.DateTime]</span>
            <div class="space-y-1">
                @{
                    var infoTitleParts = Model.Title.Split(new[] { " - " }, StringSplitOptions.None);
                    var cleanDate = infoTitleParts.Length > 0 ? infoTitleParts[0] : Model.EventDate.ToString("dd/MM/yyyy");
                }
                <p class="text-xl font-bold text-white">@cleanDate</p>
                <p class="text-stone-400">h. @Model.EventDate.ToString("HH:mm")</p>
            </div>
        </div>

        <div class="p-8 border-r border-stone-800 flex flex-col justify-start h-full">
            <span class="text-primary text-xs uppercase tracking-widest mb-4 font-bold block min-h-[1rem]">Location</span>
            <div class="space-y-1">
                <p class="text-xl font-bold text-white leading-tight">@(Model.Location ?? "Location da definire")</p>
                @if (!string.IsNullOrEmpty(Model.Coordinates))
                {
                    @* Sostituito l'URL statico con la variabile Model.Coordinates *@
                    <a href="@Model.Coordinates" target="_blank" class="text-stone-400 text-sm underline cursor-pointer hover:text-white transition-colors block">
                        View on map
                    </a>
                }
            </div>
        </div>

        <div class="p-8 border-r border-stone-800 flex flex-col justify-start h-full">
            <span class="text-primary text-xs uppercase tracking-widest mb-4 font-bold flex items-center gap-2 min-h-[1rem]">
                <span class="material-symbols-outlined text-sm">phone_in_talk</span> @Localizer[SharedResource.Reservation]
            </span>
            <div class="space-y-1">
                <p class="text-xl font-bold text-white">
                    @(string.IsNullOrEmpty(bookingPhoneDisplay) ? "Contattaci per info" : bookingPhoneDisplay)
                </p>
            </div>
        </div>

        <div class="p-8 bg-primary text-white flex flex-col justify-start items-center h-full">
            <span class="text-white/70 text-xs uppercase tracking-widest mb-4 font-bold block min-h-[1rem]">@Localizer[SharedResource.Price] </span>
            <div class="text-center">
                <p class="text-3xl font-bold">@Model.Price.ToString("N2") €</p>
            </div>
        </div>

    </div>
</section>

<!-- Gallery -->
<main class="container mx-auto px-12 py-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-24">

        <div class="lg:col-span-7">
            <div class="mb-16">
                <div class="prose prose-invert max-w-none text-lg leading-relaxed text-stone-400 space-y-6">
                    @Html.Raw(Model.Description)
                </div>
            </div>

            @if (Model.Gallery?.Photos != null && Model.Gallery.Photos.Any())
            {
                <div class="mb-16">
                    <h3 class="text-2xl font-bold mb-8 text-white flex items-center">
                        <span class="w-8 h-px bg-primary mr-4"></span>
                        Gallery
                    </h3>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        @foreach (var photo in Model.Gallery.Photos)
                        {
                            <div class="relative aspect-square group cursor-zoom-in">
                                <img src="@photo.ImageUrl"
                                     alt="@photo.Caption"
                                     class="relative z-10 w-full h-full object-cover rounded-xl border border-stone-800 transition-all duration-500 origin-center group-hover:scale-[1.5] group-hover:z-50 group-hover:shadow-[0_0_50px_rgba(0,0,0,0.9)]" />
                            </div>
                        }
                    </div>
                </div>
            }
        </div> <div class="lg:col-span-5">
            @if (Model.Authors != null && Model.Authors.Any())
            {
                <div class="space-y-4">
                    <h3 class="text-xl font-bold text-white uppercase tracking-widest mb-6">Expert</h3>
                    @foreach (var expert in Model.Authors)
                    {
                        <div class="flex items-center p-6 bg-dark-card rounded-xl border border-stone-800">
                            <img src="@expert.PhotoUrl" alt="@expert.Name" class="w-20 h-20 rounded-full object-cover grayscale">
                            <div class="ml-6">
                                <span class="text-[10px] uppercase tracking-widest text-primary font-bold">Expert</span>
                                <h4 class="text-lg font-bold text-white leading-tight">@expert.Name</h4>
                                <p class="text-sm text-stone-500 italic">@expert.Bio</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</main>

<div class="fixed bottom-0 left-0 right-0 z-50 p-6 flex justify-center pointer-events-none">
    <div class="pointer-events-auto bg-[#1a1a1a]/95 backdrop-blur-xl border border-white/10 rounded-2xl px-8 py-4 flex items-center space-x-12 shadow-[0_20px_50px_rgba(0,0,0,0.5)]">
        <div class="hidden md:block">
            @*  <p class="text-white/60 text-xs uppercase tracking-widest font-bold">Inclusioni Evento</p> *@
            <p class="text-white text-sm italic">@(string.IsNullOrEmpty(Model.Subtitle) ? "Exclusive Wine Experience" : Model.Subtitle)</p>
        </div>
        <div class="h-10 w-px bg-white/10 hidden md:block"></div>
        <div class="flex items-center space-x-8">
            <div class="text-center md:text-left">
                <p class="text-primary font-bold text-xl leading-none">@Model.Price.ToString("N2") €</p>
            </div>

            @if (isEventPast)
            {
                <button type="button" disabled class="@buttonStyles py-3 px-10 rounded-xl uppercase tracking-widest text-xs font-bold">
                    @Localizer[SharedResource.EventFinished]
                </button>
            }
            else
            {
                <button type="button" onclick="handleBookingClick()" class="@buttonStyles py-3 px-10 rounded-xl transition-all uppercase tracking-widest text-xs font-bold">
                    @Localizer[SharedResource.ReserveYourSeat]
                </button>
            }
        </div>
    </div>
</div>


@section Scripts {
    <script>
        function handleBookingClick() {
            const isMobileUA = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
            const rawPhone = "@bookingPhoneRaw";

            if (isMobileUA) {
                window.location.href = "@Html.Raw(bookingHref)";
            } else {
                if (rawPhone.startsWith("3")) {
                    window.open(`https://web.whatsapp.com/send?phone=39${rawPhone}`, '_blank');
                } else {
                    window.location.href = `tel:+39${rawPhone}`;
                }
            }
        }
    </script>
}