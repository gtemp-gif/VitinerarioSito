@using Vitinerario.Models
@model HomeViewModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="container-fluid px-0">
    @foreach (var item in Model.Sections)
    {
        <div class="row g-0 align-items-center mb-5 section-container" style="min-height: 50vh;">
            @if (item.IsImageLeft)
            {
                <div class="col-md-6 order-2 order-md-1">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="img-fluid w-100 section-image" alt="@item.Title" style="object-fit: cover; height: 100%; max-height: 600px;" />
                    }
                </div>
                <div class="col-md-6 order-1 order-md-2 p-5 text-center text-md-start">
                    @if (!string.IsNullOrEmpty(item.Title))
                    {
                        <h2 class="fw-bold mb-3 display-5">@item.Title</h2>
                    }
                    <p class="lead mb-4">@item.Description</p>
                    @if (!string.IsNullOrEmpty(item.LinkUrl))
                    {
                        <a href="@item.LinkUrl" class="btn btn-outline-light rounded-pill px-4 py-2">@item.LinkText</a>
                    }
                </div>
            }
            else
            {
                <div class="col-md-6 order-1 p-5 text-center text-md-start">
                     @if (!string.IsNullOrEmpty(item.Title))
                    {
                        <h2 class="fw-bold mb-3 display-5">@item.Title</h2>
                    }
                    <p class="lead mb-4">@item.Description</p>
                    @if (!string.IsNullOrEmpty(item.LinkUrl))
                    {
                        <a href="@item.LinkUrl" class="btn btn-outline-light rounded-pill px-4 py-2">@item.LinkText</a>
                    }
                </div>
                <div class="col-md-6 order-2">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="img-fluid w-100 section-image" alt="@item.Title" style="object-fit: cover; height: 100%; max-height: 600px;" />
                    }
                </div>
            }
        </div>
    }
</div>
