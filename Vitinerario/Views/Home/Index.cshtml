<!-- Citazione -->

<section class="bg-charcoal-light py-32 border-y border-white/5 my-12">
    <div class="max-w-4xl mx-auto px-6 text-center">
        @* Icona leggermente più piccola per non sovrastare il testo *@
        <span class="material-symbols-outlined text-primary text-4xl mb-8 opacity-40">format_quote</span>

        @* Rimosso uppercase e font-black. Aggiunto font-serif e italic *@
        <blockquote class="text-3xl md:text-4xl font-serif italic font-light leading-relaxed text-white/90 mb-10">
            @Localizer[SharedResource.BlockquoteHome]
        </blockquote>

        <div class="h-px w-12 bg-primary mx-auto mb-6"></div>

        @* L'autore rimane tecnico e maiuscolo per creare un bellissimo contrasto con il corsivo *@
        <cite class="text-[11px] uppercase tracking-widest-plus font-bold text-white/50 not-italic">Luigi Veronelli</cite>
    </div>
</section>

<!-- Eventi -->

<section class="max-w-7xl mx-auto px-6 md:px-12 py-32 border-b border-white/5">
    <div class="flex items-end justify-between mb-20 border-b border-white/10 pb-8">
        <div>
            @* <span class="text-primary text-xs uppercase tracking-widest-plus font-bold block mb-2">Destinations</span> *@
            <h2 class="text-5xl font-black uppercase">@Localizer[SharedResource.Events]</h2>
        </div>
        <a href="@Url.Action("Events", "Home")" class="text-[11px] uppercase tracking-widest-plus font-bold text-white/50 hover:text-primary transition-colors flex items-center text-right">
            @Localizer[SharedResource.ViewAllEvents]</span>
            <span class="material-icons text-sm ml-2">add</span>
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        @if (ViewBag.LatestEvents != null && ((List<Vitinerario.Models.Dtos.EventDto>)ViewBag.LatestEvents).Any())
        {
            @foreach (var evt in (List<Vitinerario.Models.Dtos.EventDto>)ViewBag.LatestEvents)
            {
                <div class="group relative aspect-[3/4] overflow-hidden bg-dark-charcoal rounded-xl">
                    @* Immagine di copertina dinamica *@
                    <img src="@evt.CoverImage" alt="@evt.Title" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-110 transition-all duration-1000">

                    <div class="absolute inset-0 bg-gradient-to-t from-dark-charcoal via-transparent to-transparent flex flex-col justify-end p-10">
                        @* Luogo dell'evento (es: MILANO, ITALY) *@
                        <span class="text-white drop-shadow-md text-[10px] uppercase font-black mb-3 tracking-[0.2em]">
                            @evt.Location
                        </span>
                        @* Titolo dell'evento *@
                        <h5 class="text-white text-3xl font-black mb-6 leading-none uppercase">@evt.Title</h5>

                        @* Link al dettaglio evento *@
                        <a href="@Url.Action("EventDetails", "Home", new { id = evt.Id })"
                           class="text-white text-[10px] uppercase font-black border-b-2 border-primary/40 pb-2 w-fit hover:border-primary transition-all">
                            @Localizer[SharedResource.BtnDiscoverMore]
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-span-full py-10">
                <p class="text-white/30 italic text-center font-body">Nessun evento disponibile in questo momento.</p>
            </div>
        }
    </div>
</section>


<section class="relative w-full h-auto md:h-[600px] py-16 md:py-0 overflow-hidden group">
    <img src="https://www.geordie.app:441/VitinerarioGateTest/Images/Podcast/p_hero1.png""
         alt="Recording Studio environment" class="absolute inset-0 w-full h-full object-cover scale-105">
    <div class="absolute inset-0 podcast-gradient"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 h-full flex flex-col justify-center items-start">

        @* CONTENITORE HEADER: Titolo e Link sulla stessa linea *@
        <div class="flex flex-row items-end justify-between mb-8 w-full  border-white/10 ">

            @* Titolo Podcast *@
            <h2 class="text-5xl md:text-7xl font-black font-lovelo text-white leading-none">
                Podcast
            </h2>

            @* Link "Ascolta tutti" *@
            <a href="@Url.Action("Podcast", "Home")"
               class="text-[11px] uppercase tracking-widest-plus font-bold text-white/50 hover:text-primary transition-colors flex items-center pb-2">
                @Localizer[SharedResource.ListenAllEpisodes]
                <span class="material-icons text-sm ml-2">add</span>
            </a>

        </div>

        @* CONTENUTO PODCAST *@
        <div class="max-w-2xl">
            @if (ViewBag.LatestPodcasts != null && ((List<Vitinerario.Models.Dtos.ContentDto>)ViewBag.LatestPodcasts).Any())
            {
                var latestPodcast = ((List<Vitinerario.Models.Dtos.ContentDto>)ViewBag.LatestPodcasts).FirstOrDefault();
                if (latestPodcast != null)
                {
                    <h3 class="text-3xl font-bold text-white mb-4">@latestPodcast.Title</h3>
                    <p class="font-body text-xl text-white/70 leading-relaxed mb-10 max-w-lg">
                        @Html.Raw(latestPodcast.Text)
                    </p>
                }
            }
            else
            {
                <p class="font-body text-xl text-white/70 leading-relaxed mb-10 max-w-lg">
                    @if (langId == 2)
                    {
                        @:I protagonisti del mondo enogastronomico si raccontano: produttori di vino, esperti di olio evo e maestri del food condividono le loro storie, passioni e ispirazioni.
                    }
                    else
                    {
                        @:The leaders of the food and wine world tell their stories: winemakers, extra virgin olive oil experts, and culinary masters share their journeys, passions, and inspirations.
                    }
                </p>
            }

            @* BOTTONI SPOTIFY / YOUTUBE *@
            <div class="flex flex-wrap gap-6">
                <a href="https://open.spotify.com/show/5LP8P9O8idGLi4e1oBwpbX" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-primary hover:bg-opacity-90 text-white px-8 py-4 rounded-full text-xs uppercase tracking-widest font-bold transition-all transform hover:-translate-y-1">
                    <span class="material-icons text-xl">podcasts</span>
                    Listen on Spotify
                </a>
                <a href="https://www.youtube.com/%40vitinerario" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-transparent border-2 border-primary hover:bg-primary text-white px-8 py-4 rounded-full text-xs uppercase tracking-widest font-bold transition-all transform hover:-translate-y-1">
                    <span class="material-icons text-xl">play_circle_filled</span>
                    Watch on YouTube
                </a>
            </div>
        </div>
    </div>
</section>

