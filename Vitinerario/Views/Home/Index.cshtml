<section class="max-w-7xl mx-auto px-6 md:px-12 py-32 border-b border-white/5">
    <div class="flex items-end justify-between mb-16">
        <div>
            <span class="text-primary text-xs uppercase tracking-widest-plus font-bold block mb-2">Real Time</span>
            <h2 class="text-5xl font-black">News</h2>
        </div>
        <a href="#" class="text-[11px] uppercase tracking-widest-plus font-bold text-white/50 hover:text-primary transition-colors flex items-center">
            Global Feed <span class="material-icons text-sm ml-2">rss_feed</span>
        </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        @if (ViewBag.LatestNews != null && ((List<Vitinerario.Models.Dtos.ContentDto>)ViewBag.LatestNews).Any())
        {
            @foreach (var newsItem in (List<Vitinerario.Models.Dtos.ContentDto>)ViewBag.LatestNews)
            {
                <article class="group cursor-pointer flex flex-col">
                    <div class="relative aspect-[16/10] overflow-hidden mb-6">
                        <img src="@newsItem.CoverImage" alt="@newsItem.Title" class="w-full h-full object-cover grayscale-[0.2] group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700">
                        <div class="absolute top-4 left-4">
                            <span class="bg-primary text-white text-[9px] px-3 py-1 font-black uppercase tracking-widest">News</span>
                        </div>
                    </div>
                    <a href="@Url.Action("Article", "Home", new { id = newsItem.Id })" class="flex items-center gap-2 text-primary font-bold text-xs tracking-[0.15em] hover:gap-4 transition-all uppercase">
                        <h4 class="font-lovelo text-xl font-bold mb-3 leading-tight group-hover:text-primary transition-colors uppercase">@newsItem.Title</h4>
                    </a>
                    <p class="font-body text-sm text-white/50 leading-relaxed mb-4 line-clamp-2">@Html.Raw(newsItem.Text)</p>
                    <div class="mt-auto flex items-center justify-between">
                        <span class="text-[9px] font-bold text-white/30 uppercase tracking-widest">@newsItem.PublishDate.ToString("dd MMM yyyy")</span>
                        <a href="@Url.Action("Article", "Home", new { id = newsItem.Id })"
                           class="opacity-0 group-hover:opacity-100 transition-opacity">
                            <span class="material-icons text-primary text-sm">arrow_forward</span>
                        </a>
                    </div>
                </article>
            }
        }
    </div>
</section>

