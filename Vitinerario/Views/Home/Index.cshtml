<section class="bg-dark-charcoal border-b border-white/5 py-12 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 md:px-12 mb-8">
        <span class="text-primary text-xs uppercase tracking-widest-plus font-bold block mb-2">Official Partners</span>
    </div>

    @if (partners.Any())
    {
        <div class="flex overflow-hidden whitespace-nowrap">
            @* Aggiunto un pochino di padding verticale per far respirare i loghi *@
            <div class="flex animate-scroll items-center gap-24 py-4">
                @foreach (var partner in partners)
                {
                    if (!string.IsNullOrEmpty(partner.LinkUrl))
                    {
                        @* Rimosso "partner-logo" per evitare filtri CSS nascosti nel tuo site.css *@
                        <a href="@partner.LinkUrl" target="_blank" rel="noopener noreferrer" class="hover:scale-110 transition-transform duration-300">
                            <img src="@partner.ImageUrl" alt="@partner.Description" title="@partner.Description" class="h-14 md:h-16 w-auto object-contain">
                        </a>
                    }
                    else
                    {
                        <img src="@partner.ImageUrl" alt="@partner.Description" title="@partner.Description" class="h-14 md:h-16 w-auto object-contain">
                    }
                }
            </div>
        </div>
    }
</section>
<section class="max-w-7xl mx-auto px-6 md:px-12 py-32 border-b border-white/5">
    <div class="flex items-end justify-between mb-16">
        <div>
            <h2 class="text-5xl font-black">News</h2>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        @if (ViewBag.LatestNews != null)
        {
            var newsList = (List<Vitinerario.Models.Dtos.ContentDto>)ViewBag.LatestNews;
            @foreach (var newsItem in newsList)
            {
                // 1. LOGICA DI CALCOLO URL (BACKEND DELLA VIEW)
                string finalUrl = "";
                if (newsItem.Links != null && newsItem.Links.Any())
                {
                    var linkData = newsItem.Links[0];
                    if (newsItem.CategoryId == 1 || newsItem.CategoryId == 2)
                    {
                        var rawLink = linkData.LinkUrl ?? "";
                        // Pulizia della stringa "/ID" -> "ID"
                        var cleanId = rawLink.Replace("/", "").Trim();
                        if (int.TryParse(cleanId, out int targetId))
                        {
                            finalUrl = Url.Action("EventDetails", "Home", new { id = targetId });
                        }
                    }
                    else if (newsItem.CategoryId == 3 || newsItem.CategoryId == 4)
                    {
                        finalUrl = linkData.LinkUrl;
                    }
                    else
                    {
                        var rawLink = linkData.LinkUrl ?? "";
                        // Pulizia della stringa "/ID" -> "ID"
                        var cleanId = rawLink.Replace("/", "").Trim();
                        if (int.TryParse(cleanId, out int targetId))
                        {
                            finalUrl = Url.Action("Article", "Home", new { id = targetId });
                        }
                    
                    }
                }

                // 2. HTML PULITO (Evitiamo <a> dentro <a>)
                <article class="group flex flex-col h-full relative">
                    <div class="relative aspect-[16/10] overflow-hidden mb-6 rounded-xl bg-charcoal-light">
                        <img src="@newsItem.CoverImage" alt="@newsItem.Title" class="w-full h-full object-cover grayscale-[0.2] group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700">
                        <div class="absolute top-4 left-4">
                            <span class="bg-primary text-white text-[9px] px-3 py-1 font-black uppercase tracking-widest">News</span>
                        </div>
                        @* Link invisibile che copre solo l'immagine se vuoi *@
                        <a href="@finalUrl" target="@(newsItem.CategoryId >= 3 ? "_blank" : "_self")" class="absolute inset-0 z-10"></a>
                    </div>

                    <div class="flex flex-col flex-grow">
                        @* Titolo con il suo link *@
                        <a href="@finalUrl" target="@(newsItem.CategoryId >= 3 ? "_blank" : "_self")" class="z-20">
                            <h4 class="font-display text-xl font-black mb-3 leading-tight group-hover:text-primary transition-colors uppercase tracking-tight">
                                @newsItem.Title
                            </h4>
                        </a>
                        <p class="font-body text-sm text-white/50 leading-relaxed mb-4 line-clamp-3">
                            @Html.Raw(newsItem.Text)
                        </p>
                    </div>

                    <div class="mt-auto pt-6 flex items-center justify-between border-t border-white/5">
                        <span class="text-[9px] font-bold text-white/30 uppercase tracking-widest">
                            @newsItem.PublishDate.ToString("dd MMM yyyy")
                        </span>

                        @* Bottone finale *@
                       
                        <a href="@finalUrl"
                           target="@(newsItem.CategoryId >= 3 ? "_blank" : "_self")"
                           class="z-20 flex items-center gap-2 text-primary font-black text-[10px] uppercase tracking-widest group-hover:gap-4 transition-all">

                            @Localizer[SharedResource.BtnDiscover]

                            <span class="material-symbols-outlined text-sm">arrow_forward</span>
                        </a>
                    </div>
                </article>
            }
        }
    </div>
</section>
