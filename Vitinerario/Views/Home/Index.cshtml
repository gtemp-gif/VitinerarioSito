<section class="max-w-7xl mx-auto px-6 md:px-12 py-32 border-b border-white/5">
	<div class="flex flex-col md:flex-row items-start md:items-end justify-between gap-4 md:gap-0 mb-20 border-b border-white/10 pb-8">
		<div>
			<h2 class="text-5xl font-black uppercase">@Localizer[SharedResource.Events]</h2>
		</div>
		<a href="@Url.Action("Events", "Home")" class="text-[11px] uppercase tracking-widest-plus font-bold text-white/50 hover:text-primary transition-colors flex items-center text-left md:text-right">
			@Localizer[SharedResource.ViewAllEvents]
			<span class="material-icons text-sm ml-2">add</span>
		</a>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-3 gap-10">
		@if (ViewBag.LatestEvents != null && ((List<Vitinerario.Models.Dtos.EventDto>)ViewBag.LatestEvents).Any())
		{
			@foreach (var evt in (List<Vitinerario.Models.Dtos.EventDto>)ViewBag.LatestEvents)
			{
				<div class="group relative aspect-square overflow-hidden bg-black rounded-xl border border-white/5 shadow-2xl">

					<a href="@Url.Action("EventDetails", "Home", new { id = evt.Id })" class="absolute inset-0 z-30"></a>

					<div class="absolute inset-0 opacity-40 group-hover:opacity-60 transition-opacity duration-700">
						<img src="@evt.CoverImage" alt="@evt.Title" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
					</div>

					<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent z-10 pointer-events-none"></div>

					<div class="absolute inset-0 flex flex-col justify-end p-6 md:p-8 z-20 pointer-events-none">

						@{
							// LOGICA DI SEPARAZIONE (Data e Nome)
							string datePart = "";
							string namePart = evt.Title;

							if (evt.Title.Contains(" - "))
							{
								var parts = evt.Title.Split(new[] { " - " }, 2, StringSplitOptions.None);
								datePart = parts[0].Trim();
								namePart = parts[1].Trim();
							}
							else if (evt.Title.Contains("_"))
							{
								var parts = evt.Title.Split(new[] { "_" }, 2, StringSplitOptions.None);
								datePart = parts[0].Trim();
								namePart = parts[1].Trim();
							}
						}

						<div class="flex items-center gap-1 text-white/60 text-[10px] uppercase font-bold mb-4 tracking-[0.2em]">
							<span class="material-symbols-outlined text-[14px]">location_on</span>
							<span class="truncate">@evt.Location</span>
						</div>

						@if (!string.IsNullOrEmpty(datePart))
						{
							<span class="block text-primary text-[11px] uppercase font-black tracking-widest mb-1 drop-shadow-md">
								@datePart
							</span>
						}

						<h5 class="text-white text-2xl md:text-3xl font-bold italic mb-6 leading-tight uppercase drop-shadow-xl line-clamp-2">
							@Html.Raw(namePart)
						</h5>

						<div class="flex items-center gap-2 text-white font-black uppercase text-[10px] tracking-widest border-b-2 border-primary/40 pb-2 w-fit group-hover:border-primary group-hover:text-primary transition-all">
							@Localizer[SharedResource.BtnDiscoverMore]
							<span class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1">arrow_forward</span>
						</div>
					</div>
				</div>
			}
		}
		else
		{
			<div class="col-span-full py-10">
				<p class="text-white/30 italic text-center font-body">Nessun evento disponibile in questo momento.</p>
			</div>
		}
	</div>
</section>

