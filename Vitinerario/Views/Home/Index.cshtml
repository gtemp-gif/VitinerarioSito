<main class="max-w-7xl mx-auto px-6 md:px-12 py-32">
    <div class="flex items-end justify-between mb-20 border-b border-white/10 pb-8">
        <div>
            <span class="text-primary text-xs uppercase tracking-widest-plus font-bold block mb-2">Curated</span>
            <h2 class="text-5xl font-black">Articoli</h2>
        </div>
        <a href="@Url.Action("Archive")" class="text-[11px] uppercase tracking-widest-plus font-bold text-white/50 hover:text-primary transition-colors flex items-center">
            Leggi tutti gli articoli <span class="material-icons text-sm ml-2">add</span>
        </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-16">
        @if (ViewBag.LatestArticles != null && ((List<Vitinerario.Models.Dtos.ContentDto>)ViewBag.LatestArticles).Any())
        {
            var firstArticle = ((List<Vitinerario.Models.Dtos.ContentDto>)ViewBag.LatestArticles).First();
            var remainingArticles = ((List<Vitinerario.Models.Dtos.ContentDto>)ViewBag.LatestArticles).Skip(1).ToList();

            <div class="md:col-span-8 group cursor-pointer">
                <div class="relative overflow-hidden mb-8 aspect-[16/9]">
                    <img src="@firstArticle.CoverImage" alt="@firstArticle.Title" class="w-full h-full object-cover grayscale-[0.3] group-hover:grayscale-0 transition-all duration-1000 group-hover:scale-105">
                    <div class="absolute inset-0 ring-1 ring-inset ring-white/10"></div>
                </div>
                <div class="space-y-6">
                    <span class="text-primary text-[10px] uppercase tracking-widest-plus font-black">@firstArticle.ContentType</span>
                    <a href="@Url.Action("Article", "Home", new { id = firstArticle.Id })" class="block">
                        <h3 class="text-4xl md:text-5xl font-black group-hover:text-primary transition-colors leading-tight">
                            @firstArticle.Title
                        </h3>
                    </a>
                    <p class="text-white/60 leading-relaxed text-lg max-w-2xl line-clamp-3">@Html.Raw(firstArticle.Text)</p>
                    <div class="pt-4 flex items-center text-[10px] font-bold uppercase tracking-widest-plus text-white/40">
                        <span class="text-white/70">
                            @if (firstArticle.Authors != null && firstArticle.Authors.Any())
                            {
                                @string.Join(", ", firstArticle.Authors.Select(a => a.Name))
                            }
                            else
                            {
                                @:Editorial Team
                            }
                        </span>
                        <span class="mx-4 text-primary opacity-50">/</span>
                        <span>@firstArticle.PublishDate.ToString("dd MMM yyyy")</span>
                    </div>

                </div>
            </div>

            <div class="md:col-span-4 flex flex-col gap-16">
                @foreach (var article in remainingArticles)
                {
                    <div class="group cursor-pointer">
                        <div class="relative overflow-hidden mb-6 aspect-[4/3]">
                            <img src="@article.CoverImage" alt="@article.Title" class="w-full h-full object-cover grayscale-[0.3] group-hover:grayscale-0 transition-all duration-1000 group-hover:scale-105">
                            <div class="absolute inset-0 ring-1 ring-inset ring-white/10"></div>
                        </div>
                        <span class="text-primary text-[10px] uppercase tracking-widest-plus font-black">@article.ContentType</span>
                        <a href="@Url.Action("Article", "Home", new { id = article.Id })" class="block">
                            <h4 class="text-xl font-bold mt-4 group-hover:text-primary transition-colors leading-snug">@article.Title</h4>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</main>
