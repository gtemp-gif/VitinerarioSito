@using Vitinerario.Resources.Views.Shared
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer[Privacy.PageTitle];
    Layout = "_LayoutVitinerario";
   
}

@section TailwindConfig {
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#d11a51",
                        "background-light": "#f8f6f6",
                        "background-dark": "#121212",
                    },
                    fontFamily: {
                        "display": ["Noto Serif", "serif"],
                        "lovelo": ["Montserrat", "sans-serif"],
                        "body": ["Roboto", "sans-serif"]
                    },
                    borderRadius: {"DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px"},
                },
            },
        }
    </script>
}

@section Styles {
    <style>
        .lovelo-heading {
            font-family: 'Montserrat', sans-serif;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            font-weight: 900;
        }

        .progress-bar {
            height: 2px;
            background: #d11a51;
            position: fixed;
            top: 0;
            left: 0;
            width: 30%;
            z-index: 100;
        }

        .editorial-line {
            height: 1px;
            background: linear-gradient(to right, #d11a51, transparent);
        }
    </style>
}

<main class="flex-1 max-w-7xl mx-auto w-full px-6 md:px-16 pt-24 pb-32">
   
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">

        <!-- Sticky Sidebar Navigation -->
        <aside class="lg:col-span-3 hidden lg:block">
            <div class="sticky top-40 flex flex-col gap-8">
                <h4 class="lovelo-heading text-xs text-slate-500">
                    @Localizer[Privacy.Directory]</h4>

                <nav class="flex flex-col gap-4">
                    <a href="#intro" class="text-primary text-sm flex items-center gap-3 font-medium">
                        <span class="text-[10px] lovelo-heading">01</span> @Localizer[Privacy.Nav_Intro]
                    </a>
                    <a href="#data" class="text-slate-400 hover:text-white text-sm flex items-center gap-3 transition-colors">
                        <span class="text-[10px] lovelo-heading">02</span> @Localizer[Privacy.Nav_DataCollected]
                    </a>
                    <a href="#usage" class="text-slate-400 hover:text-white text-sm flex items-center gap-3 transition-colors">
                        <span class="text-[10px] lovelo-heading">03</span> @Localizer[Privacy.Nav_UseOfData]
                    </a>
                    <a href="#thirdparty" class="text-slate-400 hover:text-white text-sm flex items-center gap-3 transition-colors">
                        <span class="text-[10px] lovelo-heading">04</span> @Localizer[Privacy.Nav_ThirdParties]
                    </a>
                    <a href="#rights" class="text-slate-400 hover:text-white text-sm flex items-center gap-3 transition-colors">
                        <span class="text-[10px] lovelo-heading">05</span> @Localizer[Privacy.Nav_RightsSecurity]
                    </a>
                    <a href="#changes" class="text-slate-400 hover:text-white text-sm flex items-center gap-3 transition-colors">
                        <span class="text-[10px] lovelo-heading">06</span> @Localizer[Privacy.Nav_ChangesContact]
                    </a>
                </nav>

                <div class="mt-12 p-6 border border-white/5 bg-white/[0.02] rounded-lg">
                    <p class="text-xs text-slate-500 leading-relaxed italic">
                        @Localizer[Privacy.Sidebar_LastUpdatedLabel] <span class="text-slate-300">@Localizer[Privacy.LastUpdated]</span>
                    </p>
                </div>
            </div>
        </aside>

        <!-- Content Sections -->
        <div class="lg:col-span-8 lg:col-start-5 space-y-32">

            <!-- Section 1 -->
            <section id="intro" class="scroll-mt-32">
                <div class="flex items-start gap-8 mb-8">
                    <span class="lovelo-heading text-4xl text-primary opacity-50">01</span>
                    <h2 class="lovelo-heading text-3xl text-white pt-2">@Localizer[Privacy.Intro_Title]</h2>
                </div>

                <div class="space-y-6 text-slate-300 text-lg leading-[1.8] font-light">
                    <p>@Localizer[Privacy.Intro_P1]</p>
                    <p>@Localizer[Privacy.Intro_P2]</p>
                    <p>@Localizer[Privacy.Intro_P3]</p>
                </div>
            </section>

            <!-- Section 2 -->
            <section id="data" class="scroll-mt-32">
                <div class="flex items-start gap-8 mb-8">
                    <span class="lovelo-heading text-4xl text-primary opacity-50">02</span>
                    <h2 class="lovelo-heading text-3xl text-white pt-2">@Localizer[Privacy.Data_Title]</h2>
                </div>

                <div class="space-y-6 text-slate-300 text-lg leading-[1.8] font-light">
                    <p>@Localizer[Privacy.Data_P1]</p>

                    <ul class="list-none space-y-4 pl-0">
                        <li class="flex gap-4">
                            <span class="text-primary mt-1 opacity-70">/</span>
                            <span>@Localizer[Privacy.Data_Item1]</span>
                        </li>
                        <li class="flex gap-4">
                            <span class="text-primary mt-1 opacity-70">/</span>
                            <span>@Localizer[Privacy.Data_Item2]</span>
                        </li>
                        <li class="flex gap-4">
                            <span class="text-primary mt-1 opacity-70">/</span>
                            <span>@Localizer[Privacy.Data_Item3]</span>
                        </li>
                        <li class="flex gap-4">
                            <span class="text-primary mt-1 opacity-70">/</span>
                            <span>@Localizer[Privacy.Data_Item4]</span>
                        </li>
                        <li class="flex gap-4">
                            <span class="text-primary mt-1 opacity-70">/</span>
                            <span>@Localizer[Privacy.Data_Item5]</span>
                        </li>
                    </ul>

                    <p class="text-slate-500 text-base border-t border-white/5 pt-6">
                        @Localizer[Privacy.Data_P2]
                    </p>
                </div>
            </section>

            <!-- Section 3 -->
            <section id="usage" class="scroll-mt-32">
                <div class="flex items-start gap-8 mb-8">
                    <span class="lovelo-heading text-4xl text-primary opacity-50">03</span>
                    <h2 class="lovelo-heading text-3xl text-white pt-2">@Localizer[Privacy.Usage_Title]</h2>
                </div>

                <div class="bg-primary/5 border-l-2 border-primary p-8 mb-8">
                    <p class="text-white font-medium mb-4 italic">@Localizer[Privacy.Usage_Box_Title]</p>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        @Localizer[Privacy.Usage_Box_Text]
                    </p>
                </div>

                <div class="space-y-6 text-slate-300 text-lg leading-[1.8] font-light">
                    <p>@Localizer[Privacy.Usage_P1]</p>
                    <p>@Localizer[Privacy.Usage_P2]</p>
                </div>
            </section>

            <!-- Section 4 -->
            <section id="thirdparty" class="scroll-mt-32">
                <div class="flex items-start gap-8 mb-8">
                    <span class="lovelo-heading text-4xl text-primary opacity-50">04</span>
                    <h2 class="lovelo-heading text-3xl text-white pt-2">@Localizer[Privacy.ThirdParty_Title]</h2>
                </div>

                <div class="space-y-6 text-slate-300 text-lg leading-[1.8] font-light">
                    <p>@Localizer[Privacy.ThirdParty_P1]</p>
                    <p>@Localizer[Privacy.ThirdParty_P2]</p>

                    <div class="bg-primary/5 border-l-2 border-primary p-8 mb-8">
                        <p class="text-white font-medium mb-4 italic">
                            @Localizer[Privacy.ThirdParty_Box_Title]</p>

                        <ul class="list-none space-y-4 pl-0 text-slate-300 text-base">
                            <li class="flex gap-4">
                                <span class="text-primary mt-1 opacity-70">/</span>
                                <span>@Localizer[Privacy.ThirdParty_Item1]</span>
                            </li>
                            <li class="flex gap-4">
                                <span class="text-primary mt-1 opacity-70">/</span>
                                <span>@Localizer[Privacy.ThirdParty_Item2]</span>
                            </li>
                            <li class="flex gap-4">
                                <span class="text-primary mt-1 opacity-70">/</span>
                                <span>@Localizer[Privacy.ThirdParty_Item3]</span>
                            </li>
                        </ul>
                    </div>

                    <p>@Localizer[Privacy.ThirdParty_P3]</p>
                </div>
            </section>

            <!-- Section 5 -->
            <section id="rights" class="scroll-mt-32">
                <div class="flex items-start gap-8 mb-8">
                    <span class="lovelo-heading text-4xl text-primary opacity-50">05</span>
                    <h2 class="lovelo-heading text-3xl text-white pt-2">@Localizer[Privacy.Rights_Title]</h2>
                </div>

                <div class="space-y-6 text-slate-300 text-lg leading-[1.8] font-light">
                    <p>@Localizer[Privacy.Rights_P1]</p>

                    <ul class="list-none space-y-4 pl-0">
                        <li class="flex gap-4">
                            <span class="text-primary mt-1 opacity-70">/</span>
                            <span>@Localizer[Privacy.Rights_Item1]</span>
                        </li>
                        <li class="flex gap-4">
                            <span class="text-primary mt-1 opacity-70">/</span>
                            <span>@Localizer[Privacy.Rights_Item2]</span>
                        </li>
                        <li class="flex gap-4">
                            <span class="text-primary mt-1 opacity-70">/</span>
                            <span>@Localizer[Privacy.Rights_Item3]</span>
                        </li>
                        <li class="flex gap-4">
                            <span class="text-primary mt-1 opacity-70">/</span>
                            <span>@Localizer[Privacy.Rights_Item4]</span>
                        </li>
                    </ul>

                    <p class="text-slate-500 text-base border-t border-white/5 pt-6">
                        @Localizer[Privacy.Rights_P2]
                    </p>
                </div>
            </section>

            <!-- Section 6 -->
            <section id="changes" class="scroll-mt-32">
                <div class="flex items-start gap-8 mb-8">
                    <span class="lovelo-heading text-4xl text-primary opacity-50">06</span>
                    <h2 class="lovelo-heading text-3xl text-white pt-2">@Localizer[Privacy.Changes_Title]</h2>
                </div>

                <div class="space-y-6 text-slate-300 text-lg leading-[1.8] font-light">
                    <p>@Localizer[Privacy.Changes_P1]</p>
                    <p>@Localizer[Privacy.Changes_P2]</p>

                    <div class="mt-12 flex items-center gap-6 p-8 rounded-xl bg-white/[0.03] border border-white/10">
                        <span class="material-symbols-outlined text-4xl text-primary">mail</span>
                        <div>
                            <p class="text-white font-medium">@Localizer[Privacy.Contact_Title]</p>
                            <p class="text-slate-400 text-sm">
                                @Localizer[Privacy.Contact_Text]
                                <a href="mailto:info@vitinerario.it" class="text-primary hover:underline transition-all">
                                    info@vitinerario.it
                                </a>
                            </p>
                        </div>
                    </div>
                </div>
            </section>

        </div>
    </div>
</main>	


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sections = document.querySelectorAll('section[id]');
            const navLinks = document.querySelectorAll('aside nav a');

            // 1. Creiamo una funzione unica che "accende" il link giusto e "spegne" gli altri
            function setActiveLink(targetId) {
                navLinks.forEach(link => {
                    // Controlliamo se il link corrisponde alla sezione passata
                    if (link.getAttribute('href') === `#${targetId}`) {
                        // Accendiamo di rosa
                        link.classList.remove('text-slate-400', 'hover:text-white');
                        link.classList.add('text-primary');
                    } else {
                        // Spegniamo e facciamo tornare grigi gli altri
                        link.classList.remove('text-primary');
                        link.classList.add('text-slate-400', 'hover:text-white');
                    }
                });
            }

            // 2. AGGIUNTA FONDAMENTALE: Gestione diretta del CLIC
            navLinks.forEach(link => {
                link.addEventListener('click', function(e) {
                    // Estrae l'id (es. "intro" da "#intro")
                    const targetId = this.getAttribute('href').substring(1);
                    // Cambia il colore istantaneamente prima ancora che la pagina scorra
                    setActiveLink(targetId);
                });
            });

            // 3. Gestione dello scorrimento manuale con margini allargati
            const observerOptions = {
                root: null,
                rootMargin: '-10% 0px -40% 0px', // Area allargata per intercettare meglio i titoli
                threshold: 0
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const currentId = entry.target.getAttribute('id');
                        setActiveLink(currentId);
                    }
                });
            }, observerOptions);

            sections.forEach(section => {
                observer.observe(section);
            });
        });
    </script>
}