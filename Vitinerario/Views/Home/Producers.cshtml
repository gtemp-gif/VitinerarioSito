<script>
    document.addEventListener('DOMContentLoaded', () => {
        const track = document.getElementById('carousel-track');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');

        // Dynamic Focus Logic
        const updateFocus = () => {
            const trackCenter = track.getBoundingClientRect().left + track.clientWidth / 2;
            const items = track.querySelectorAll('.group\\/item');

            let closestItem = null;
            let minDistance = Infinity;

            items.forEach(item => {
                const rect = item.getBoundingClientRect();
                const itemCenter = rect.left + rect.width / 2;
                const distance = Math.abs(trackCenter - itemCenter);

                if (distance < minDistance) {
                    minDistance = distance;
                    closestItem = item;
                }
            });

            items.forEach(item => {
                const img = item.querySelector('.carousel-img');
                if (item === closestItem) {
                    // Active State
                    img.style.filter = 'grayscale(0%)';
                    img.style.opacity = '1';
                    img.style.transform = 'scale(1.05)';
                } else {
                    // Inactive State
                    img.style.filter = 'grayscale(100%)';
                    img.style.opacity = '0.7';
                    img.style.transform = 'scale(0.95)';
                }
            });
        };

        // Attach scroll listener
        track.addEventListener('scroll', updateFocus);
        // Initial call
        updateFocus();

        // Use first child width as scroll step, fallback to screen width percentage
        function getScrollStep() {
             const firstItem = track.firstElementChild;
             return firstItem ? firstItem.clientWidth + 24 : window.innerWidth * 0.8; // 24 is gap
        }

        const scrollNext = () => {
            const step = getScrollStep();
            // Check if we are at the end
            if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 10) {
                 track.scrollTo({ left: 0, behavior: 'smooth' });
            } else {
                 track.scrollBy({ left: step, behavior: 'smooth' });
            }
        };

        const scrollPrev = () => {
             const step = getScrollStep();
             track.scrollBy({ left: -step, behavior: 'smooth' });
        };

        nextBtn.addEventListener('click', () => {
            scrollNext();
            resetAutoplay();
        });

        prevBtn.addEventListener('click', () => {
            scrollPrev();
            resetAutoplay();
        });

        // Autoplay
        let autoplayInterval = setInterval(scrollNext, 5000);

        function resetAutoplay() {
            clearInterval(autoplayInterval);
            autoplayInterval = setInterval(scrollNext, 5000);
        }

        // Pause on hover (optional but recommended for UX)
        track.addEventListener('mouseenter', () => clearInterval(autoplayInterval));
        track.addEventListener('mouseleave', () => resetAutoplay());

        // Update focus on window resize as center point changes
        window.addEventListener('resize', updateFocus);
    });
</script>
