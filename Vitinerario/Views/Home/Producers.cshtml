            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#d11a51",
                        "background-light": "#f8f6f6",
                        "background-dark": "#121212", // Deep Charcoal
                        "charcoal": "#121212",
                    },
