        @* 2. Gradiente Scuro *@
        <div class="absolute inset-0 hero-gradient"></div>

        @* 3. Contenuto Centrato sopra lo sfondo *@
        <div class="relative z-10 max-w-4xl mx-auto px-6 w-full text-center text-white mt-12">

            <p class="text-primary font-bold tracking-[0.2em] uppercase text-xs mb-4">@Localizer[SharedResource.PodcastTagline]</p>
            <h1 class="text-5xl md:text-8xl font-black text-white uppercase font-display leading-none mb-6">Vitinerario PODCAST</h1>

