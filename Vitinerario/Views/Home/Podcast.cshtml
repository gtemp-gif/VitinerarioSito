@using Microsoft.AspNetCore.Mvc.Localization
@using Vitinerario.Resources.Views.Shared
@inject IViewLocalizer Localizer

@{
    Layout = "_LayoutVitinerario";
    ViewData["Title"] = "Vitinerario | The Podcast Archive";
}

@section TailwindConfig {
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#D31A53",
                        "background-dark": "#121212",
                        "surface-dark": "#1E1E1E",
                        "burgundy-glow": "rgba(211, 26, 83, 0.2)",
                        "stone-grey": "#A8A29E"
                    },
                    fontFamily: {
                        "body": ["Roboto", "sans-serif"],
                        "display": ["Montserrat", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0px",
                        "lg": "0px",
                        "xl": "0px",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
}

@section Styles {
    <style>
        @@font-face {
            font-family: 'Lovelo';
            src: url('https://fonts.cdnfonts.com/css/lovelo');
        }
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #121212 !important;
            color: #A8A29E;
        }
        h1, h2, h3, h4, .font-display {
            font-family: 'Lovelo', sans-serif !important;
            text-transform: uppercase !important;
            letter-spacing: 0.05em;
            color: #FFFFFF;
        }
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        .burgundy-button {
            background-color: #D31A53;
            color: white;
            transition: background-color 0.3s ease;
        }
        .burgundy-button:hover {
            background-color: #b01544;
            box-shadow: 0 0 15px rgba(211, 26, 83, 0.4);
        }
    </style>
}

<main class="max-w-[1400px] mx-auto px-6 lg:px-20 pt-32 pb-12">
