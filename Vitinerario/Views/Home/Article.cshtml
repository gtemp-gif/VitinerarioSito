        <div class="md:w-3/4 space-y-12">

            @* BLOCCO TESTO E LINK *@
            <div class="space-y-6 text-slate-300 leading-relaxed text-lg font-light">
                @if (!string.IsNullOrEmpty(Model.Preview))
                {
                    <p class="drop-cap whitespace-pre-line">
                        @Html.Raw(Model.Preview)
                    </p>
                }

                @* SEZIONE LINK ESTERNO *@
                @* Nota: Usa Model.Links se è una lista, oppure adatta a Model.Link se è un oggetto singolo *@
                @if (Model.Links != null && Model.Links.Any())
                {
                    <div class="pt-4 border-t border-white/10 mt-8">
                        @foreach (var linkItem in Model.Links)
                        {
                            if (!string.IsNullOrEmpty(linkItem.LinkUrl))
                            {
                                <a href="@linkItem.LinkUrl" target="_blank" rel="noopener noreferrer"
                                   class="inline-flex items-center gap-3 text-primary font-bold hover:text-white transition-colors group">

                                    <span class="material-symbols-outlined text-lg group-hover:scale-110 transition-transform">open_in_new</span>

                                    @* Mostra la Description se presente, altrimenti mostra l'URL nudo come fallback *@
                                    <span class="underline underline-offset-4 decoration-primary/30 group-hover:decoration-white">
                                        @(!string.IsNullOrEmpty(linkItem.Description) ? linkItem.Description : linkItem.LinkUrl)
                                    </span>

                                </a>
                            }
                        }
                    </div>
                }
            </div>

            @* BLOCCO IMMAGINI (Invariato) *@
            @if (Model.Images != null && Model.Images.Count > 0)
            {
                <div class="grid grid-cols-1 md:grid-cols-12 gap-4 h-auto md:h-[600px]">
                    <div class="md:col-span-8 h-[300px] md:h-full rounded-xl overflow-hidden group">
                        <img class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 moody-image"
                             src="@Model.Images[0].ImageUrl" alt="Gallery 1" />
                    </div>
                    <div class="md:col-span-4 flex flex-row md:flex-col gap-4 h-[150px] md:h-full">
                        @if (Model.Images.Count > 1)
                        {
                            <div class="h-full md:h-1/2 w-1/2 md:w-full rounded-xl overflow-hidden group border border-white/5">
                                <img class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 moody-image"
                                     src="@Model.Images[1].ImageUrl" alt="Gallery 2" />
                            </div>
                        }
                        @if (Model.Images.Count > 2)
                        {
                            <div class="h-full md:h-1/2 w-1/2 md:w-full rounded-xl overflow-hidden group border border-white/5">
                                <img class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 moody-image"
                                     src="@Model.Images[2].ImageUrl" alt="Gallery 3" />
                            </div>
                        }
                    </div>
                </div>
            }

        </div>
    </article>

