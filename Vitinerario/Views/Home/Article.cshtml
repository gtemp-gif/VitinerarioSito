@model Vitinerario.Models.Dtos.ContentDto

@{
    Layout = "_LayoutVitinerario";
    ViewData["Title"] = $"Vitinerario | {Model?.Title ?? "Article"}";
    int langId = Vitinerario.Helpers.LanguageHelper.GetCurrentLangId(Context);
}

@section TailwindConfig {
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#d31a53",
                        "dark-charcoal": "#121212",
                        "charcoal-light": "#1e1e1e",
                        "accent-burgundy": "#d31a53",
                    },
                    fontFamily: {
                        "body": ["Roboto", "sans-serif"],
                        "display": ["Montserrat", "sans-serif"],
                        "lovelo": ["Montserrat", "sans-serif"]
                    },
                    letterSpacing: {
                        "widest-plus": "0.3em",
                        "architectural": "0.05em"
                    }
                },
            },
        }
    </script>
}

@section Styles {
    <style type="text/tailwindcss">
        @@layer base {
            body {
                @@apply bg-dark-charcoal text-zinc-300 font-body antialiased;
            }

            h1, h2, h3, h4 {
                @@apply font-display uppercase tracking-tight;
            }
        }

        .premium-gradient {
            background: linear-gradient(180deg, rgba(18,18,18,0) 0%, rgba(18,18,18,0.8) 80%, rgba(18,18,18,1) 100%);
        }

        .moody-image {
            filter: sepia(20%) contrast(110%) brightness(85%);
            transition: filter 0.5s ease;

            .moody-image:hover {
                filter: sepia(10%) contrast(105%) brightness(95%);
            }

            .drop-cap::first-letter {
                float: left;
                font-size: 5rem;
                line-height: 0.8;
                padding-top: 0.5rem;
                padding-right: 0.75rem;
                color: #d31a53;
                font-weight: 900;
                font-family: 'Montserrat', sans-serif;
            }
        }
    </style>
}

<main class="flex-1">
    <section class="relative h-[90vh] w-full overflow-hidden">
        <div class="absolute inset-0 bg-cover bg-center transition-transform duration-1000 scale-105"
             style="background-image: url('@(string.IsNullOrEmpty(Model.HeroImage) ? "https://lh3.googleusercontent.com/aida-public/AB6AXuC9CibRg0FEJMIx_IF0wDafKtBz9Of6mJSJzt8FNPkwn68AXlU0wSzMVySgbxpkhNipWuxCx1EgfhgeL-q0HKM6YetYzVk5hvh2U4Ourjc8u9aryFv0HcnBTnDtpLq0FGBkk4sM8f5B_NisBBGCQV5XggSKUXXBvQTERI5MSk-4ClAHHSADTPyq9TI3tT5ONKkQ5xNyK_6MKs4A2azaXY6QVy7wTNtTM39-horsNDrtxez270omuM4p5LLYSLgZPvNk5jkRMkyYK00" : Model.HeroImage)');">
        </div>
        <div class="absolute inset-0 premium-gradient"></div>
        <div class="absolute bottom-0 left-0 w-full p-8 md:p-20 flex flex-col items-start gap-6">
            <div class="flex items-center gap-3">
                <span class="text-slate-400 text-sm">@Model.PublishDate.ToString("MMMM yyyy")</span>
            </div>
            <h1 class="text-5xl md:text-8xl font-black max-w-4xl leading-[0.9] text-white tracking-tighter">
                @Model.Title
            </h1>
        </div>
    </section>

    <article class="mx-auto max-w-[1200px] px-6 md:px-12 py-24 flex flex-col md:flex-row gap-16">
