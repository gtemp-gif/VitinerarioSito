                                <img class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 moody-image"
                                     src="@Model.Images[1].ImageUrl" alt="Gallery 2" />
                            </div>
                            <div class="flex-1 relative rounded-xl overflow-hidden group border border-white/5">
                                <img class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 moody-image"
                                     src="@Model.Images[2].ImageUrl" alt="Gallery 3" />
                            </div>
                        </div>
                    </div>
                }
                else if (Model.Images.Count == 2)
                {
                    @* PIANO B: 2 foto. Aggiunto aspect-[4/3] e w-full h-full per farle essere due cornici identiche! *@
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="aspect-square md:aspect-[4/3] rounded-xl overflow-hidden group border border-white/5">
