                        </div>
                        <div class="aspect-square md:aspect-[4/3] rounded-xl overflow-hidden group border border-white/5">
                            <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 moody-image"
                                 src="@Model.Images[1].ImageUrl" alt="Gallery 2" />
                        </div>
                    </div>
                }
                else if (Model.Images.Count == 1)
                {
