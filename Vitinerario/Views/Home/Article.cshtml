@model Vitinerario.Models.Dtos.ContentDto

@{
    Layout = "_LayoutVitinerario";
    ViewData["Title"] = $"Vitinerario | {Model?.Title ?? "Article"}";
}

@section TailwindConfig {
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#d31a53",
                        "dark-charcoal": "#121212",
                        "charcoal-light": "#1e1e1e",
                        "accent-burgundy": "#d31a53",
                    },
                    fontFamily: {
                        "body": ["Roboto", "sans-serif"],
                        "display": ["Montserrat", "sans-serif"],
                        "lovelo": ["Montserrat", "sans-serif"]
                    },
                    letterSpacing: {
                        "widest-plus": "0.3em",
                        "architectural": "0.05em"
                    }
                },
            },
        }
    </script>
}

@section Styles {
    <style type="text/tailwindcss">
        @@layer base {
            body {
                @@apply bg-dark-charcoal text-zinc-300 font-body antialiased;
            }

            h1, h2, h3, h4 {
                @@apply font-display uppercase tracking-tight;
            }
        }

        .premium-gradient {
            background: linear-gradient(180deg, rgba(18,18,18,0) 0%, rgba(18,18,18,0.8) 80%, rgba(18,18,18,1) 100%);
        }

        .moody-image {
            filter: sepia(20%) contrast(110%) brightness(85%);
            transition: filter 0.5s ease;
        }

            .moody-image:hover {
                filter: sepia(10%) contrast(105%) brightness(95%);
            }

        .drop-cap::first-letter {
            float: left;
            font-size: 5rem;
            line-height: 0.8;
            padding-top: 0.5rem;
            padding-right: 0.75rem;
            color: #d31a53;
            font-weight: 900;
            font-family: 'Montserrat', sans-serif;
        }
    </style>
}

<main class="flex-1">
    <section class="relative h-[90vh] w-full overflow-hidden">
        <div class="absolute inset-0 bg-cover bg-center transition-transform duration-1000 scale-105"
             style="background-image: url('@(string.IsNullOrEmpty(Model.CoverImage) ? "https://lh3.googleusercontent.com/aida-public/AB6AXuC9CibRg0FEJMIx_IF0wDafKtBz9Of6mJSJzt8FNPkwn68AXlU0wSzMVySgbxpkhNipWuxCx1EgfhgeL-q0HKM6YetYzVk5hvh2U4Ourjc8u9aryFv0HcnBTnDtpLq0FGBkk4sM8f5B_NisBBGCQV5XggSKUXXBvQTERI5MSk-4ClAHHSADTPyq9TI3tT5ONKkQ5xNyK_6MKs4A2azaXY6QVy7wTNtTM39-horsNDrtxez270omuM4p5LLYSLgZPvNk5jkRMkyYK00" : Model.CoverImage)');">
        </div>
        <div class="absolute inset-0 premium-gradient"></div>
        <div class="absolute bottom-0 left-0 w-full p-8 md:p-20 flex flex-col items-start gap-6">
            <div class="flex items-center gap-3">
                <span class="text-slate-400 text-sm">@Model.PublishDate.ToString("MMMM yyyy")</span>
            </div>
            <h1 class="text-5xl md:text-8xl font-black max-w-4xl leading-[0.9] text-white tracking-tighter">
                @Model.Title
            </h1>
        </div>
    </section>

    <article class="mx-auto max-w-[1200px] px-6 py-24 flex flex-col md:flex-row gap-16">
        <aside class="md:w-1/4 flex flex-col gap-12">
            <div class="space-y-4">
                <h4 class="text-primary text-xs uppercase tracking-widest font-bold">Scritto da</h4>
                <div class="flex items-center gap-4">
                    <div class="size-16 rounded-full overflow-hidden border border-primary/30">
                        <img class="h-full w-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB4gHx3a0hVz6s4ha25jvFFb-QCvk1KI18F7HoU6ahpO5-VA3n4HMejT9MhchRQMFXxftRrcS0Iuf1x8fw-SXaJBHelXenvYRunKHlMZbUQbixwCXdA72XYp7XyddNXn31R56OF81MV_eTqjQqZYQZT6HU9Ga65FxlA8kWydvIjstiSwdrT-OAo0y9zZBUGlK2Iq9_6vfqh8K5msoL1fyM4ED3eEIuY9oVs1ckvlw6PrvStva2YI4fJCp7-ZNMPnjWCtC-RUoi2p30" alt="Author" />
                    </div>
                    <div>
                        <p class="text-white font-bold">Vitinerario Team</p>
                        <p class="text-slate-500 text-sm">Redazione</p>
                    </div>
                </div>
            </div>

            <div class="space-y-3">
                <h4 class="text-white/30 text-xs uppercase tracking-widest font-bold">Published</h4>
                <p class="text-white/60 uppercase text-sm tracking-wide">@Model.PublishDate.ToString("MMM dd, yyyy")</p>
            </div>

            <div class="space-y-6 pt-2">
                <button type="button" class="flex items-center gap-3 text-white/40 hover:text-primary transition-colors uppercase tracking-widest text-xs font-bold">
                    <span class="material-symbols-outlined text-base">share</span> Share
                </button>
                <button type="button" class="flex items-center gap-3 text-white/40 hover:text-primary transition-colors uppercase tracking-widest text-xs font-bold">
                    <span class="material-symbols-outlined text-base">bookmark</span> Save
                </button>
            </div>
        </aside>

        <div class="md:w-3/4 space-y-12">
            <div class="space-y-6 text-slate-300 leading-relaxed text-lg font-light">
                @if (!string.IsNullOrEmpty(Model.Text))
                {
                    <p class="drop-cap whitespace-pre-line">
                        @Model.Text
                    </p>
                }
            </div>

            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 h-[600px] md:h-[600px] auto-rows-fr">
                <div class="md:col-span-8 h-full rounded-xl overflow-hidden group">
                    <img class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 moody-image"
                         src="@Model.CoverImage" alt="Gallery 1" />
                </div>
                <div class="md:col-span-4 flex flex-col gap-4">
                    <div class="h-1/2 rounded-xl overflow-hidden group border border-white/5">
                        <div class="h-full w-full bg-charcoal-light flex items-center justify-center">
                            <span class="text-primary/20 text-4xl font-display">VIT</span>
                        </div>
                    </div>
                    <div class="h-1/2 rounded-xl overflow-hidden group border border-white/5">
                        <div class="h-full w-full bg-charcoal-light flex items-center justify-center">
                            <span class="text-primary/20 text-4xl font-display">ART</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </article>

    <section class="bg-dark-charcoal border-t border-white/5 py-24 px-6 md:px-20">
        <div class="mx-auto max-w-[1400px]">
            <div class="flex justify-between items-end mb-12">
                <div>
                    <h2 class="text-4xl font-display text-white">Altri articoli</h2>
                    <p class="text-slate-500 mt-2 italic font-body">Continua l'esplorazione</p>
                </div>
                <a class="text-primary font-bold flex items-center gap-2 group" href="@Url.Action("Archive")">
                    View All <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">arrow_forward</span>
                </a>
            </div>

            @* Qui potresti inserire una lista di "Related" passata tramite ViewBag o PartialView *@
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 opacity-50 pointer-events-none">
                <div class="group">
                    <div class="aspect-[16/10] rounded-xl overflow-hidden mb-4 border border-white/10 bg-charcoal-light"></div>
                    <h3 class="text-xl font-display text-white">Loading more stories...</h3>
                </div>
            </div>
        </div>
    </section>
</main>