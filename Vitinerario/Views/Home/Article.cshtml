@{
    Layout = "_LayoutVitinerario";
    ViewData["Title"] = "Vitinerario | The Soul of Tuscany's Hidden Vineyards";
}

@section TailwindConfig {
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#d31a53",
                        "charcoal": "#121212",
                        "charcoal-light": "#1e1e1e",
                        "accent-burgundy": "#d31a53",
                    },
                    fontFamily: {
                        "sans": ["Roboto", "sans-serif"],
                        "display": ["Montserrat", "sans-serif"], // Lovelo alternative
                    },
                },
            },
        }
    </script>
}

@section Styles {
    <style type="text/tailwindcss">
        @@layer base {
            body {
                @@apply bg-charcoal text-zinc-300 font-sans;
            }
            h1, h2, h3, h4 {
                @@apply font-display uppercase tracking-tight;
            }
        }
        .moody-image {
            filter: sepia(20%) contrast(110%) brightness(85%);
            transition: filter 0.5s ease;
        }
        .moody-image:hover {
            filter: sepia(10%) contrast(105%) brightness(95%);
        }
        .drop-cap::first-letter {
            float: left;
            font-size: 5rem;
            line-height: 0.8;
            padding-top: 0.5rem;
            padding-right: 0.75rem;
            color: #d31a53;
            font-weight: 900;
            font-family: 'Montserrat', sans-serif;
        }
        .reading-progress-bar {
            width: 42%;
        }::selection {
            background-color: #d31a53;
            color: white;
        }
    </style>
}

<div class="fixed top-0 left-0 w-full h-1 z-50 bg-white/5">
    <div class="h-full bg-accent-burgundy reading-progress-bar"></div>
</div>

<nav class="sticky top-0 z-40 bg-charcoal/95 backdrop-blur-md border-b border-white/5 px-8 py-5 flex justify-between items-center">
