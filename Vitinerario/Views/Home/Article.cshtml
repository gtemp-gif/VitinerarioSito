
@{

    Layout = "_LayoutVitinerario";
    ViewData["Title"] = "Vitinerario | The Soul of Tuscany's Hidden Vineyards";
}

@section TailwindConfig {
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#d31a53",
                        "charcoal": "#121212",
                        "charcoal-light": "#1e1e1e",
                        "accent-burgundy": "#d31a53",
                    },
                    fontFamily: {
                        "sans": ["Roboto", "sans-serif"],
                        "display": ["Montserrat", "sans-serif"], // Lovelo alternative
                    },
                },
            },
        }
    </script>
} 

@section Styles {
    <style type="text/tailwindcss">
        @@layer base {
            body {
                @@apply bg-charcoal text-zinc-300 font-sans;
            }
            h1, h2, h3, h4 {
                @@apply font-display uppercase tracking-tight;
            }
        }
        .moody-image {
            filter: sepia(20%) contrast(110%) brightness(85%);
            transition: filter 0.5s ease;
        }
        .moody-image:hover {
            filter: sepia(10%) contrast(105%) brightness(95%);
        }
        .drop-cap::first-letter {
            float: left;
            font-size: 5rem;
            line-height: 0.8;
            padding-top: 0.5rem;
            padding-right: 0.75rem;
            color: #d31a53;
            font-weight: 900;
            font-family: 'Montserrat', sans-serif;
        }
        .reading-progress-bar {
            width: 42%;
        }::selection {
            background-color: #d31a53;
            color: white;
        }
    </style>
    }




<main class="flex-1">
    <section class="relative h-[90vh] w-full overflow-hidden">
        <div class="absolute inset-0 bg-cover bg-center transition-transform duration-1000 scale-105"
             data-alt="Close up of a premium wine producer in a sun-drenched vineyard"
             style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuC9CibRg0FEJMIx_IF0wDafKtBz9Of6mJSJzt8FNPkwn68AXlU0wSzMVySgbxpkhNipWuxCx1EgfhgeL-q0HKM6YetYzVk5hvh2U4Ourjc8u9aryFv0HcnBTnDtpLq0FGBkk4sM8f5B_NisBBGCQV5XggSKUXXBvQTERI5MSk-4ClAHHSADTPyq9TI3tT5ONKkQ5xNyK_6MKs4A2azaXY6QVy7wTNtTM39-horsNDrtxez270omuM4p5LLYSLgZPvNk5jkRMkyYK00');">
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-charcoal via-charcoal/40 to-transparent"></div>
        <div class="absolute bottom-0 left-0 w-full p-8 md:p-20 flex flex-col items-start gap-6">
            <div class="flex items-center gap-3">
                <span class="bg-primary px-3 py-1 text-[10px] uppercase tracking-[0.2em] font-bold text-white">The Terroir Series</span>
                <span class="text-slate-400 text-sm">October 2023</span>
            </div>
            <h1 class="text-5xl md:text-8xl font-black max-w-4xl leading-[0.9] text-white tracking-tighter">
                THE SILENT <br/>ALCHEMY OF <br/><span class="text-primary">MARCO VALENTI</span>
            </h1>
            <p class="text-lg md:text-xl text-slate-300 max-w-2xl font-light leading-relaxed">
                Deep in the rolling hills of Tuscany, one man is redefining the boundaries between tradition and modern Viticulture. We spent a week discovering the secrets of his legendary cellar.
            </p>
        </div>
    </section>
</main>

