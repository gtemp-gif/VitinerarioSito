        <aside class="md:w-1/4 flex flex-col gap-12">
            @* Sezione Autore Dinamica *@
            <div class="space-y-4">
                <h4 class="text-primary text-xs uppercase tracking-widest font-bold">@(langId == 2 ? "Scritto da" : "Written by")</h4>

                @if (Model.Authors != null && Model.Authors.Any())
                {
                    @foreach (var author in Model.Authors)
                    {
                        <div class="flex items-center gap-4">
                            <div class="size-16 rounded-full overflow-hidden border border-primary/30">
                                @* Immagine dall'API: photoUrl *@
                                <img class="h-full w-full object-cover grayscale hover:grayscale-0 transition-all duration-500"
                                     src="@author.PhotoUrl"
                                     alt="@author.Name" />
                            </div>
                            <div>
                                @* Nome dall'API: name *@
                                <p class="text-white font-bold">@author.Name</p>
                                @* Bio dall'API: bio (accorciata se necessario) *@
                                @* <p class="text-slate-500 text-xs leading-tight">@author.Bio</p> *@
                            </div>
                        </div>
                    }
                }
                else
                {
                    @* Fallback se l'autore non è presente nel JSON *@
                    <div class="flex items-center gap-4">
                        <div class="size-16 rounded-full overflow-hidden border border-primary/30 bg-stone-800 flex items-center justify-center">
                            <span class="material-symbols-outlined text-stone-600">person</span>
                        </div>
                        <div>
                            <p class="text-white font-bold">Vitinerario Team</p>
                            <p class="text-slate-500 text-sm">Redazione</p>
                        </div>
                    </div>
                }
            </div>

            @* Sezione Data di Pubblicazione *@
            <div class="space-y-3">
                <h4 class="text-white/30 text-xs uppercase tracking-widest font-bold">@(langId == 2 ? "Pubblicato" : "Published")</h4>
                <p class="text-white/60 uppercase text-sm tracking-wide">@Model.PublishDate.ToString("MMM dd, yyyy")</p>
            </div>

            @* Sezione Azioni (Share & Save) *@
            <div class="space-y-6 pt-2">
                <button type="button"
                        onclick="handleShare()"
                        class="flex items-center gap-3 text-white/40 hover:text-primary transition-colors uppercase tracking-widest text-xs font-bold">
                    <span class="material-symbols-outlined text-base">share</span> @(langId == 2 ? "Condividi" : "Share")
                </button>
                <button type="button" class="flex items-center gap-3 text-white/40 hover:text-primary transition-colors uppercase tracking-widest text-xs font-bold">
                    <span class="material-symbols-outlined text-base">bookmark</span> @(langId == 2 ? "Salva" : "Save")
                </button>
            </div>
        </aside>
