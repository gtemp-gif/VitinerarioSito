            <script>
    document.addEventListener("DOMContentLoaded", function () {
        // Passiamo la lingua dal Razor al JS una volta sola
        const langId = @langId; 

        // --- 1. GESTIONE CONDIVIDI ---
        const btnShare = document.getElementById('btn-share');
        if (btnShare) {
            btnShare.addEventListener('click', async function () {
                // Leggiamo il titolo dall'attributo, così apostrofi e virgolette non spaccano nulla
                const title = this.getAttribute('data-title');
                const url = window.location.href;

                // Funzione di emergenza (Copia negli appunti)
                const fallbackCopy = () => {
                    if (navigator.clipboard) {
                        navigator.clipboard.writeText(url).then(() => {
                            alert(langId == 2 ? "Link copiato negli appunti!" : "Link copied to clipboard!");
                        }).catch(err => {
                            alert("Impossibile copiare il link automaticamente.");
                        });
                    } else {
                        prompt("Copia questo link:", url);
                    }
                };

                // Tentativo condivisione nativa
                if (navigator.share) {
                    try {
                        await navigator.share({
                            title: title,
                            url: url
                        });
                    } catch (err) {
                        if (err.name !== 'AbortError') {
                            fallbackCopy();
                        }
                    }
                } else {
                    fallbackCopy();
                }
            });
        }

        // --- 2. GESTIONE SALVA ---
        const btnSave = document.getElementById('btn-save');
        if (btnSave) {
            const currentArticleId = btnSave.getAttribute('data-id');
            let savedArticles = JSON.parse(localStorage.getItem('vitinerario_saved')) || [];
            
            // Imposta lo stato iniziale al caricamento
            if (savedArticles.includes(currentArticleId)) {
                toggleSaveUI(true, langId);
            }

            // Al click sul bottone
            btnSave.addEventListener('click', function () {
                // Rilegge sempre lo stato più fresco dal localStorage
                savedArticles = JSON.parse(localStorage.getItem('vitinerario_saved')) || [];
                const isSaved = savedArticles.includes(currentArticleId);

                if (isSaved) {
                    savedArticles = savedArticles.filter(id => id !== currentArticleId);
                    toggleSaveUI(false, langId);
                } else {
                    savedArticles.push(currentArticleId);
                    toggleSaveUI(true, langId);
                }
                
                localStorage.setItem('vitinerario_saved', JSON.stringify(savedArticles));
            });
        }
    });

    // --- FUNZIONE GRAFICA PER IL PULSANTE SALVA ---
    function toggleSaveUI(isSaved, langId) {
        const icon = document.getElementById('icon-save');
        const text = document.getElementById('text-save');

        if (isSaved) {
            icon.classList.add('text-primary');
            icon.classList.remove('text-white/40');
            text.classList.add('text-primary');
            text.classList.remove('text-white/40');
            icon.style.fontVariationSettings = "'FILL' 1"; 
            text.innerText = langId == 2 ? "Salvato" : "Saved";
        } else {
            icon.classList.remove('text-primary');
            icon.classList.add('text-white/40');
            text.classList.remove('text-primary');
            text.classList.add('text-white/40');
            icon.style.fontVariationSettings = "'FILL' 0";
            text.innerText = langId == 2 ? "Salva" : "Save";
        }
    }
</script>