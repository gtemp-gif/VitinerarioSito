@model Vitinerario.Models.PartecipaViewModel

@{
    Layout = "_LayoutVitinerario";
    ViewData["Title"] = "Partecipa all'Evento";
}

<main>
    <section class="relative h-[85vh] flex items-center justify-center overflow-hidden">
        <div class="absolute inset-0 z-0">
            <div class="absolute inset-0 bg-gradient-to-b from-charcoal/60 via-charcoal/40 to-charcoal z-10"></div>
            <img alt="Cinematic vineyard at sunset" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAkNcSS6UhGwjRBR67iOnQOcJlRYAWcQs_vAB7G2kR--C2Se4XKCfnY5l74dUpm32cSR-Vm6cOZuWh9s9b37xn3GXEULm9K8-zcjTh_aMKVTZtJAB2-5xNmUibJfj0f8-2r823-e_eaBz9rCJgAdPVWgeQJzXTaAQiuiQcEcXwxHc2mguCy6l_YLEwjBjIBPc6ZQ2YU7thRWBY5tFilhb-bGjGTyWhExaeK0hiZI8aM-TqZ7xmh2G-laQt7PtDcxJtNNGKNM6pYrZA"/>
        </div>
        <div class="relative z-20 text-center px-6 max-w-4xl mx-auto">
            <h2 class="text-white text-6xl md:text-8xl font-black mb-6 leading-none uppercase">Join the Journey</h2>
            <p class="text-white/90 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed mb-10">
                Experience world-class wine, culture, and sensory immersion through our curated events designed for the discerning traveler.
            </p>
            <button onclick="document.getElementById('partecipa-form-section').scrollIntoView({behavior: 'smooth'})" class="bg-primary text-white px-12 py-4 rounded-lg text-lg font-bold uppercase tracking-widest hover:scale-105 transition-transform shadow-lg shadow-primary/20">
                Explore Experiences
            </button>
        </div>
        <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-20 animate-bounce cursor-pointer" onclick="document.getElementById('partecipa-form-section').scrollIntoView({behavior: 'smooth'})">
            <span class="material-symbols-outlined text-white text-3xl">keyboard_double_arrow_down</span>
        </div>
    </section>

    <section id="partecipa-form-section" class="flex items-center justify-center py-20 px-6 bg-charcoal">
        <div class="max-w-md w-full bg-charcoal-light border border-white/5 p-8 rounded-xl shadow-2xl relative">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mb-6 p-4 bg-green-500/10 border border-green-500 text-green-400 rounded text-sm font-bold">
                    @TempData["SuccessMessage"]
                </div>
            }

            <div class="text-center mb-10">
                <h2 class="text-3xl font-lovelo font-black text-white mb-2 uppercase">Join the Circle</h2>
                <p class="text-white/50 text-sm">Secure your place at our exclusive events.</p>
            </div>

            <form asp-action="Partecipa" method="post" class="space-y-6">
                <div class="space-y-2">
                    <label asp-for="Nome" class="text-[10px] uppercase tracking-widest font-bold text-white/60 block"></label>
                    <input asp-for="Nome" class="w-full bg-charcoal border border-white/10 rounded px-4 py-3 text-sm text-white placeholder-white/20 focus:ring-1 focus:ring-primary focus:border-primary transition-all" placeholder="Il tuo nome" />
                    <span asp-validation-for="Nome" class="text-primary text-xs font-bold mt-1 block"></span>
                </div>

                <div class="space-y-2">
                    <label asp-for="Cognome" class="text-[10px] uppercase tracking-widest font-bold text-white/60 block"></label>
                    <input asp-for="Cognome" class="w-full bg-charcoal border border-white/10 rounded px-4 py-3 text-sm text-white placeholder-white/20 focus:ring-1 focus:ring-primary focus:border-primary transition-all" placeholder="Il tuo cognome" />
                    <span asp-validation-for="Cognome" class="text-primary text-xs font-bold mt-1 block"></span>
                </div>

                <div class="space-y-2">
                    <label asp-for="Email" class="text-[10px] uppercase tracking-widest font-bold text-white/60 block"></label>
                    <input asp-for="Email" class="w-full bg-charcoal border border-white/10 rounded px-4 py-3 text-sm text-white placeholder-white/20 focus:ring-1 focus:ring-primary focus:border-primary transition-all" placeholder="email@esempio.com" />
                    <span asp-validation-for="Email" class="text-primary text-xs font-bold mt-1 block"></span>
                </div>

                <div class="space-y-2">
                    <label asp-for="Evento" class="text-[10px] uppercase tracking-widest font-bold text-white/60 block"></label>
                    <select asp-for="Evento" asp-items="ViewBag.Eventi" class="w-full bg-charcoal border border-white/10 rounded px-4 py-3 text-sm text-white focus:ring-1 focus:ring-primary focus:border-primary transition-all">
                        <option value="">-- Seleziona un Evento --</option>
                    </select>
                    <span asp-validation-for="Evento" class="text-primary text-xs font-bold mt-1 block"></span>
                </div>

                <button type="submit" class="w-full bg-primary hover:bg-opacity-90 text-white py-4 rounded text-xs font-black uppercase tracking-widest transition-all mt-4">
                    Invia Richiesta
                </button>
            </form>

            <div class="mt-8 text-center">
                <a asp-controller="Home" asp-action="Index" class="text-white/40 hover:text-white text-xs uppercase tracking-widest transition-colors">Torna alla Home</a>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
