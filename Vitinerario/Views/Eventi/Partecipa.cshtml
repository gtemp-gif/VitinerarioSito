@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const carousels = document.querySelectorAll('.overflow-x-auto');

            carousels.forEach(carousel => {
                let isDown = false;
                let startX;
                let scrollLeft;
                let autoScrollInterval;

                const dotsContainer = carousel.nextElementSibling;
                let dots = [];
                if (dotsContainer && dotsContainer.classList.contains('flex', 'justify-center')) {
                    dots = dotsContainer.querySelectorAll('div');
                }

                function updateDots() {
                    if (dots.length === 0) return;
                    const scrollRatio = carousel.scrollLeft / (carousel.scrollWidth - carousel.clientWidth);
                    const activeIndex = Math.min(Math.round(scrollRatio * (dots.length - 1)), dots.length - 1);

                    dots.forEach((dot, index) => {
                        if (index === activeIndex) {
                            dot.classList.remove('bg-primary/20');
                            dot.classList.add('bg-primary');
                        } else {
                            dot.classList.remove('bg-primary');
                            dot.classList.add('bg-primary/20');
                        }
                    });
                }

                carousel.addEventListener('scroll', updateDots);

                // Mouse Drag Scrolling
                carousel.addEventListener('mousedown', (e) => {
                    isDown = true;
                    carousel.classList.add('cursor-grabbing');
                    startX = e.pageX - carousel.offsetLeft;
                    scrollLeft = carousel.scrollLeft;
                    clearInterval(autoScrollInterval); // Pause on drag
                });
                carousel.addEventListener('mouseleave', () => {
                    isDown = false;
                    carousel.classList.remove('cursor-grabbing');
                    startAutoScroll(); // Resume on leave
                });
                carousel.addEventListener('mouseup', () => {
                    isDown = false;
                    carousel.classList.remove('cursor-grabbing');
                    startAutoScroll(); // Resume on drop
                });
                carousel.addEventListener('mousemove', (e) => {
                    if (!isDown) return;
                    e.preventDefault();
                    const x = e.pageX - carousel.offsetLeft;
                    const walk = (x - startX) * 2;
                    carousel.scrollLeft = scrollLeft - walk;
                });

                // Auto Scroll Logic
                function startAutoScroll() {
                    clearInterval(autoScrollInterval);
                    autoScrollInterval = setInterval(() => {
                        const maxScroll = carousel.scrollWidth - carousel.clientWidth;
                        const cardWidth = carousel.querySelector('div').offsetWidth + 16; // Add gap

                        if (carousel.scrollLeft >= maxScroll - 10) {
                            // Smoothly jump to start when reaching the end
                            carousel.scrollTo({ left: 0, behavior: 'smooth' });
                        } else {
                            carousel.scrollBy({ left: cardWidth, behavior: 'smooth' });
                        }
                    }, 5000);
                }

                // Initial start
                startAutoScroll();

                // Pause auto scroll on touch interaction (mobile)
                carousel.addEventListener('touchstart', () => clearInterval(autoScrollInterval), { passive: true });
                carousel.addEventListener('touchend', startAutoScroll, { passive: true });
            });
        });
    </script>
}
